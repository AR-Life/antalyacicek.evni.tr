---
import "../styles/global.css";
import { t } from "../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";
import ConfirmModal from "../components/ui/ConfirmModal.astro";
import Toast from "../components/ui/Toast.astro";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;
const { title = "Admin Panel" } = Astro.props;

// Auth check is now handled in src/middleware.ts
const token = Astro.cookies.get("admin_token")?.value;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} - Antalya Çiçek Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
</head>
<body class="bg-neutral-100 font-sans min-h-screen flex">
  
  {token && (
    <aside class="w-64 bg-white border-r border-neutral-200 flex flex-col fixed h-full z-40">
      <div class="h-16 flex items-center px-6 border-b border-neutral-200">
        <span class="text-2xl mr-2">🌸</span>
        <h1 class="font-display font-bold text-lg text-neutral-900">Antalya Çiçek</h1>
      </div>
      
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
        <div class="px-3 text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2 mt-4">Genel</div>
        <a href="/admin" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath === '/admin' ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">📊</span> Dashboard
        </a>
        <a href="/admin/orders" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/orders') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">📦</span> Siparişler
        </a>
        <a href="/admin/customers" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/customers') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">👥</span> Müşteriler
        </a>

        <div class="px-3 text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2 mt-6">Katalog</div>
        <a href="/admin/products" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/products') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">🛍️</span> Ürünler
        </a>
        <a href="/admin/categories" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/categories') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">📁</span> Kategoriler
        </a>
        <a href="/admin/occasions" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/occasions') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">🎉</span> Gönderim Amacı
        </a>

        <div class="px-3 text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2 mt-6">Sistem</div>
        <a href="/admin/settings" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/settings') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">⚙️</span> Genel Ayarlar
        </a>
        <a href="/admin/languages" class={`flex items-center px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${currentPath.startsWith('/admin/languages') ? 'bg-forest-50 text-forest-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}`}>
           <span class="mr-3 text-lg">🗣️</span> Dil Grupları
        </a>
      </nav>

      <div class="p-4 border-t border-neutral-200">
        <button id="logout-btn" class="w-full flex items-center justify-center px-4 py-2 bg-neutral-100 hover:bg-red-50 text-neutral-700 hover:text-red-600 rounded-xl text-sm font-semibold transition-colors">
          Çıkış Yap
        </button>
      </div>
    </aside>
  )}

  <main class={`flex-1 flex flex-col min-h-screen ${token ? 'ml-64' : ''}`}>
    {token && (
      <header class="h-16 bg-white border-b border-neutral-200 flex items-center justify-between px-8 sticky top-0 z-30">
        <h2 class="font-display font-semibold text-lg text-neutral-800">{title}</h2>
        <div class="flex items-center gap-4">
          <span class="text-sm text-neutral-500">Admin</span>
          <div class="w-8 h-8 rounded-full bg-forest-100 flex items-center justify-center text-forest-700 font-bold">A</div>
        </div>
      </header>
    )}
    <div class="p-8 flex-1">
      <slot />
    </div>
  </main>

  <script>
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        document.cookie = 'admin_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        window.location.href = '/admin/login';
      });
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.delete-btn') as HTMLElement;
      if (!btn) return;
      e.preventDefault();

      const url = btn.dataset.deleteUrl || '';
      const message = btn.dataset.deleteMessage || 'Bu öğeyi silmek istediğinize emin misiniz?';
      const onDeleted = btn.dataset.onDeleted || 'window.location.reload()';

      window.showConfirm('Silme Onayı', message, 'Evet, Sil', async () => {
        try {
          const res = await fetch(url, { method: 'DELETE' });
          if (res.ok) {
            showToast('Başarıyla silindi.', 'success');
            setTimeout(() => window.location.reload(), 500);
          } else {
            const data = await res.json().catch(() => ({}));
            showToast(data.error || 'Silme başarısız.', 'error');
          }
        } catch {
          showToast('Silme başarısız.', 'error');
        }
      });
    });
  </script>
  <Toast />
  <ConfirmModal />
</body>
</html>
