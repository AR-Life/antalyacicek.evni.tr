---
import { SITE } from "../data/site.config";
import { contactInfo } from "../data/contact-info";
import { type Locale } from "../i18n/config";
import { t } from "../i18n/translations";
import { formatPrice } from "../lib/currency";

interface Props {
  product: {
    id?: string;
    name: string;
    slug: string;
    description: string;
    price: number;
    oldPrice?: number;
    image?: string;
    images?: { url: string; alt?: string }[];
    tags?: string[];
    delivery?: string;
  };
  locale?: Locale;
}

const { product, locale = (Astro.locals.locale as Locale) || "tr" } = Astro.props;
const productSlug = product.slug;

const imageUrl = product.images?.[0]?.url || product.image || "https://placehold.co/400x500/f5f5f5/fda4af?text=No+Image";

const hasDiscount = product.oldPrice !== undefined && product.oldPrice > product.price;
const discountPercentage = hasDiscount
  ? Math.round(((product.oldPrice! - product.price) / product.oldPrice!) * 100)
  : 0;

const isTR = locale === "tr";

const tName = t(locale, `product.name.${productSlug}`, product.name);
const tDesc = t(locale, `product.desc.${productSlug}`, product.description);
const formattedPrice = await formatPrice(product.price, locale);
const formattedOldPrice = hasDiscount ? await formatPrice(product.oldPrice!, locale) : null;

const waMsg = `Hello, I would like to order: ${tName} - ${formattedPrice} (${SITE.url}/cicek/${product.slug})`;
const waUrl = `https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(waMsg)}`;
const cardHref = isTR ? `/cicek/${productSlug}` : waUrl;
---

<a
  href={cardHref}
  target={isTR ? "_self" : "_blank"}
  rel={isTR ? undefined : "noopener noreferrer"}
  class="group relative bg-white rounded-3xl shadow-[0_4px_16px_-4px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.11)] border border-neutral-200/60 hover:border-neutral-300 transition-all duration-300 overflow-hidden flex flex-col hover:-translate-y-1.5 hover:scale-[1.015]"
  aria-label={`${tName} - Detayları gör`}
>
  {hasDiscount && (
    <span class="absolute top-4 left-4 z-10 px-3 py-1 bg-forest-700 text-white text-[11px] font-bold tracking-wide rounded-full shadow-md shadow-forest-700/25">
      %{discountPercentage} {t(locale, "ui.sale", "İndirim")}
    </span>
  )}

  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-neutral-50 to-neutral-100/80">
    <img
      src={imageUrl}
      alt={tName}
      loading="lazy"
      width="400"
      height="500"
      class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
    
    <div class="absolute bottom-4 left-4 right-4 opacity-0 group-hover:opacity-100 translate-y-3 group-hover:translate-y-0 transition-all duration-300 ease-out">
      {isTR ? (
        <button
          type="button"
          data-order={JSON.stringify({
            name: product.name,
            price: product.price,
            image: imageUrl,
          })}
          onclick="event.preventDefault(); event.stopPropagation();"
          class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-white/95 backdrop-blur-md hover:bg-white text-forest-900 text-xs sm:text-sm font-bold rounded-2xl transition-all duration-200 shadow-lg"
          aria-label={`${tName} - Sipariş ver`}
        >
          <svg class="w-4 h-4 shrink-0 text-forest-700" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
          {t(locale, "ui.order_button", "Sipariş Ver")}
        </button>
      ) : (
        <span
          class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-green-500 hover:bg-green-600 text-white text-xs sm:text-sm font-bold rounded-2xl transition-all duration-200 shadow-lg"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
          {t(locale, "ui.order_btn", "WhatsApp ile Sipariş Ver")}
        </span>
      )}
    </div>
  </div>

  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <div class="flex flex-wrap gap-1.5 mb-2.5">
      {(product.tags || []).slice(0, 2).map((tag) => (
        <span class="text-[10px] font-semibold tracking-wide px-2.5 py-0.5 bg-neutral-100 text-neutral-600 rounded-md border border-neutral-200/50">
          {tag}
        </span>
      ))}
    </div>

    <h3 class="text-sm sm:text-base font-bold text-neutral-900 mb-1.5 leading-snug line-clamp-2 group-hover:text-forest-700 transition-colors duration-200">
      {tName}
    </h3>

    <p class="text-xs text-neutral-500/90 font-normal mb-4 line-clamp-2 leading-relaxed">
      {tDesc}
    </p>

    <div class="mt-auto pt-3.5 border-t border-neutral-100/80 flex flex-col gap-2">
      <div class="flex items-baseline gap-2">
        <span class="text-xl lg:text-2xl font-black text-neutral-900 tracking-tight">
          {formattedPrice}
        </span>
        {hasDiscount && (
          <span class="text-xs text-neutral-400 font-semibold line-through">
            {formattedOldPrice}
          </span>
        )}
      </div>
      <div class="flex items-center gap-1.5 pt-0.5 flex-wrap text-[10px] font-semibold text-neutral-600">
        <span class="inline-flex items-center gap-1 bg-neutral-100/80 px-2 py-0.5 rounded-md border border-neutral-200/60 text-neutral-600">
          🚚 45 Dk
        </span>
        <span class="inline-flex items-center gap-1 bg-emerald-50/90 px-2 py-0.5 rounded-md border border-emerald-200/60 text-emerald-700">
          🌿 Taze
        </span>
        {(hasDiscount || (product.tags && product.tags.some(t => t.toLowerCase().includes("satan") || t.toLowerCase().includes("vip") || t.toLowerCase().includes("popüler")))) && (
          <span class="inline-flex items-center gap-1 bg-amber-50/90 px-2 py-0.5 rounded-md border border-amber-200/60 text-amber-700">
            ⭐ Çok Satan
          </span>
        )}
      </div>
    </div>
  </div>
</a>
