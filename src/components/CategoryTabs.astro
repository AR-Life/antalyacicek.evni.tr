---
import type { Category } from "../data/categories";
import { getProductsByCategory } from "../data/products";
import ProductCard from "./ProductCard.astro";
import { type Locale } from "../i18n/config";
import { t } from "../i18n/translations";

interface Props {
  categories: Category[];
  locale?: Locale;
}

const { categories, locale = (Astro.locals.locale as Locale) || "tr" } = Astro.props;
const nonEmptyCategories = categories.filter((c) => getProductsByCategory(c.id).length > 0);
---

<section class="py-12 lg:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 lg:mb-10">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-2 tracking-tight">
        {t(locale, "ui.category", "Kategoriler")}
      </h2>
      <p class="text-neutral-500 max-w-xl mx-auto text-xs sm:text-sm lg:text-base font-normal">
        {t(locale, "ui.collection_desc", "Her kategoriye özel en taze çiçekler ve aranjmanlar")}
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-2 sm:gap-2.5 mb-8 lg:mb-12" id="category-tabs">
      {nonEmptyCategories.map((category, index) => (
        <button
          type="button"
          data-tab={category.slug}
          class={`tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm transition-all duration-200 ${
            index === 0
              ? 'bg-forest-800 text-white font-bold ring-2 ring-forest-600/30 shadow-[0_4px_16px_rgba(20,50,40,0.22)] scale-[1.02] -translate-y-0.5'
              : 'bg-neutral-100/80 border border-neutral-200/60 text-neutral-600 font-medium hover:bg-white hover:border-neutral-300 hover:text-neutral-900 hover:shadow-xs'
          }`}
        >
          {t(locale, `category.${category.id}`, category.name)}
        </button>
      ))}
    </div>

    <div id="category-content" class="min-h-[400px]">
      {nonEmptyCategories.map((category, index) => {
        const products = getProductsByCategory(category.id).slice(0, 8);
        return (
          <div
            id={`tab-${category.slug}`}
            class={`tab-content ${index === 0 ? 'block' : 'hidden'}`}
          >
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 lg:gap-6">
              {products.map((product) => (
                <ProductCard product={product} locale={locale} />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
(function() {
  var tabs = document.querySelectorAll('.tab-btn');
  var contents = document.querySelectorAll('.tab-content');
  var activeClasses = ['bg-forest-800', 'text-white', 'font-bold', 'ring-2', 'ring-forest-600/30', 'shadow-[0_4px_16px_rgba(20,50,40,0.22)]', 'scale-[1.02]', '-translate-y-0.5'];
  var inactiveClasses = ['bg-neutral-100/80', 'border', 'border-neutral-200/60', 'text-neutral-600', 'font-medium', 'hover:bg-white', 'hover:border-neutral-300', 'hover:text-neutral-900', 'hover:shadow-xs'];

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var targetSlug = this.getAttribute('data-tab');

      tabs.forEach(function(t) {
        activeClasses.forEach(function(c) { t.classList.remove(c); });
        inactiveClasses.forEach(function(c) { t.classList.add(c); });
      });
      inactiveClasses.forEach(function(c) { this.classList.remove(c); });
      activeClasses.forEach(function(c) { this.classList.add(c); });

      contents.forEach(function(content) {
        content.classList.add('hidden');
        content.classList.remove('block');
      });
      var targetContent = document.getElementById('tab-' + targetSlug);
      if (targetContent) {
        targetContent.classList.remove('hidden');
        targetContent.classList.add('block');
      }
    });
  });
})();
</script>
