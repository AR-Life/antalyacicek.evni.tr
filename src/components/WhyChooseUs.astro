---
import { t } from "../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;

const features = [
  {
    icon: `<svg class="w-6 h-6 text-forest-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: t(locale, "ui.why_fresh", "Her Gün Taze Çiçekler"),
    desc: t(locale, "ui.why_fresh_desc", "Günlük tedarik edilen 1. sınıf butik çiçekler ile her siparişte uzun ömürlü tazelik ve canlılık garantisi."),
    badge: "🌿 Fresh"
  },
  {
    icon: `<svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>`,
    title: t(locale, "ui.why_delivery", "45 Dakikada VIP Teslimat"),
    desc: t(locale, "ui.why_delivery_desc", "Antalya merkez bölgelerine özel motorlu kuryelerimizle en çok 45 dakika içinde özenle kapınıza teslimat."),
    badge: "🚚 Express"
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>`,
    title: t(locale, "ui.why_secure", "Güvenli ve Hızlı Ödeme"),
    desc: t(locale, "ui.why_secure_desc", "256-bit SSL güvencesiyle Visa, Mastercard, Troy veya Havale/EFT seçenekleriyle saniyelik güvenilir işlem."),
    badge: "💳 256-bit SSL"
  },
  {
    icon: `<svg class="w-6 h-6 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>`,
    title: t(locale, "ui.why_design", "Özel VIP Aranjmanlar"),
    desc: t(locale, "ui.why_design_desc", "Uzman floristlerimiz tarafından modern avrupa standartlarında hazırlanan sıradanlıktan uzak zarif konseptler."),
    badge: "🎁 Premium"
  },
  {
    icon: `<svg class="w-6 h-6 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
    title: t(locale, "ui.why_coverage", "Tüm Antalya'ya Teslimat"),
    desc: t(locale, "ui.why_coverage_desc", "Lara'dan Konyaaltı'na, Muratpaşa'dan Kepez'e kadar geniş kurye ağıyla kesintisiz teslimat güvencesi."),
    badge: "📍 Antalya"
  }
];
---

<section class="py-8 sm:py-16 lg:py-24 bg-gradient-to-b from-white via-neutral-50/40 to-white overflow-hidden border-b border-neutral-100/70">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-12 lg:mb-16">
      <span class="inline-block text-[11px] font-bold tracking-widest uppercase text-forest-600 px-3 py-1 rounded-full bg-forest-50 border border-forest-100 mb-2 sm:mb-3">
        {t(locale, "ui.why_choose_tag", "GÜVENCE & KALİTE")}
      </span>
      <h2 class="text-xl sm:text-3xl lg:text-4xl font-display font-bold text-neutral-900 tracking-tight">
        {t(locale, "ui.why_choose_title", "Neden Antalya Çiçek Evni?")}
      </h2>
      <p class="text-neutral-500 text-xs sm:text-sm lg:text-base mt-2 sm:mt-3 font-normal">
        {t(locale, "ui.why_choose_subtitle", "Modern tasarım anlayışı, VIP hız ve her adımda Apple/Stripe netliğinde prestijli müşteri deneyimi.")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5 lg:gap-6">
      {features.map((item, idx) => (
        <div class={`group/card rounded-2xl bg-white border border-neutral-200/60 p-4 sm:p-7 shadow-[0_2px_14px_-4px_rgba(0,0,0,0.03)] sm:shadow-[0_4px_20px_-4px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_30px_-6px_rgba(0,0,0,0.08)] transition-all duration-200 hover:border-neutral-300/80 hover:-translate-y-0.5 sm:hover:-translate-y-1 flex flex-col justify-between ${idx === 4 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
          <div>
            <div class="flex items-center justify-between gap-2 sm:gap-3 mb-2.5 sm:mb-5">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-neutral-50 border border-neutral-100 flex items-center justify-center transition-transform duration-200 group-hover/card:scale-105 shadow-xs">
                <div set:html={item.icon} />
              </div>
              <span class="text-[10px] sm:text-[11px] font-semibold tracking-wide text-neutral-500 bg-neutral-100/80 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md border border-neutral-200/40">
                {item.badge}
              </span>
            </div>
            <h3 class="text-[15px] sm:text-lg font-bold text-neutral-900 mb-1 sm:mb-2 tracking-tight group-hover/card:text-forest-700 transition-colors duration-200">
              {item.title}
            </h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-snug sm:leading-relaxed font-normal">
              {item.desc}
            </p>
          </div>
          <div class="w-8 h-0.5 bg-neutral-200 group-hover/card:bg-forest-500 transition-all duration-200 mt-3 sm:mt-6 rounded-full group-hover/card:w-12"></div>
        </div>
      ))}
    </div>
  </div>
</section>
