---
interface Props {
  editUrl: string;
  deleteId: string;
  deleteUrl: string;
  deleteMessage?: string;
}
const { editUrl, deleteId, deleteUrl, deleteMessage = "Bu öğeyi silmek istediğinize emin misiniz?" } = Astro.props;
---
<td class="px-6 py-4 text-right">
  <div class="flex items-center justify-end gap-1">
    <a href={editUrl} class="text-forest-600 hover:text-forest-800 font-medium px-3 py-1.5 hover:bg-forest-50 rounded-lg transition-colors">Düzenle</a>
    <button
      type="button"
      class="delete-btn text-red-500 hover:text-red-700 font-medium px-3 py-1.5 hover:bg-red-50 rounded-lg transition-colors"
      data-delete-url={deleteUrl}
      data-delete-message={deleteMessage}
    >Sil</button>
  </div>
</td>
