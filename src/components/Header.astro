---
import { SITE } from "../data/site.config";
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-neutral-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16 lg:h-20" aria-label="Ana navigasyon">
      <a
        href="/"
        class="flex items-center gap-2 group"
        aria-label={`${SITE.name} Ana Sayfa`}
      >
        <span class="text-2xl lg:text-3xl">🌸</span>
        <div class="flex flex-col">
          <span class="font-display text-lg lg:text-xl font-bold text-neutral-900 leading-tight tracking-tight">
            {SITE.name}
          </span>
          <span class="text-[10px] lg:text-xs text-rose-500 font-medium tracking-widest uppercase leading-none">
            Aynı Gün Teslimat
          </span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8">
        {[
          { href: "/#kategoriler", label: "Kategoriler" },
          { href: "/#urunler", label: "Tüm Ürünler" },
          { href: "/#teslimat", label: "Teslimat" },
          { href: "/#iletisim", label: "İletişim" },
        ].map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-neutral-600 hover:text-rose-500 transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`https://wa.me/${SITE.phoneDigits}?text=Merhaba, bilgi almak istiyorum.`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-full transition-all duration-300 shadow-md shadow-green-500/20 hover:shadow-lg hover:shadow-green-500/30"
          aria-label="WhatsApp ile iletişime geç"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>

        <button
          id="mobile-menu-toggle"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl bg-neutral-50 hover:bg-rose-50 text-neutral-600 hover:text-rose-500 transition-all duration-200"
          aria-label="Menüyü aç"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-neutral-100 bg-white"
  >
    <div class="px-4 py-4 space-y-1">
      {[
        { href: "/#kategoriler", label: "Kategoriler" },
        { href: "/#urunler", label: "Tüm Ürünler" },
        { href: "/#teslimat", label: "Teslimat" },
        { href: "/#iletisim", label: "İletişim" },
      ].map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 rounded-xl text-sm font-medium text-neutral-600 hover:text-rose-500 hover:bg-rose-50 transition-all duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`https://wa.me/${SITE.phoneDigits}?text=Merhaba, bilgi almak istiyorum.`}
        target="_blank"
        rel="noopener noreferrer"
        class="sm:hidden flex items-center justify-center gap-2 mt-3 px-4 py-3 bg-green-500 text-white text-sm font-semibold rounded-xl"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle?.setAttribute("aria-expanded", String(isOpen));
  });
</script>
