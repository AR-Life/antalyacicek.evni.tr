---
import { SITE } from "../data/site.config";
import { contactInfo } from "../data/contact-info";
import { t } from "../i18n/translations";
import { DEFAULT_LOCALE, type Locale, localePath } from "../i18n/config";
import LanguageSelector from "./LanguageSelector.astro";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-forest-100/50 text-forest-800 transition-all duration-300 ease-in-out"
>
  <div
    id="header-main"
    class="h-16 lg:h-20 flex items-center transition-all duration-300 ease-in-out"
  >
    <div
      class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"
    >
      <a href={localePath(locale, "/")} class="flex items-center shrink-0">
        <img
          src="/logo.webp"
          alt={`${SITE.name} Logo`}
          id="header-logo"
          class="h-12 lg:h-16 w-auto object-contain transition-all duration-300 ease-in-out"
          style="mix-blend-mode: multiply;"
        />
      </a>

      <div class="hidden lg:block flex-1 max-w-md">
        <div class="relative">
          <div
            class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"
          >
            <svg
              class="w-4 h-4 text-forest-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="search"
            id="search-input"
            placeholder="Çiçek ara..."
            class="w-full pl-11 pr-4 py-2.5 bg-forest-50/50 border border-forest-200/50 rounded-full text-sm font-medium text-neutral-700 placeholder:text-neutral-400 focus:outline-none focus:bg-white focus:border-forest-400 focus:ring-2 focus:ring-forest-100 transition-all"
          />
          <div
            id="search-results"
            class="absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-forest-100 hidden max-h-96 overflow-y-auto z-50"
          >
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <LanguageSelector />
        
        <a
          href={`https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp ile Sipariş"
          class="hidden sm:inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded-full transition-all duration-200 shadow-md shadow-green-500/20 hover:shadow-lg hover:shadow-green-500/30 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
            ></path></svg
          >
          <span class="hidden md:inline">Sipariş</span>
        </a>

        <button
          id="mobile-menu-btn"
          aria-label="Menüyü Aç"
          class="lg:hidden p-2 hover:bg-forest-50 rounded-full transition-colors duration-200 text-forest-800 cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-40 bg-white/98 backdrop-blur-xl text-forest-800 transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col overflow-y-auto"
>
  <button
    id="close-drawer-btn"
    class="absolute top-5 right-5 p-2 hover:bg-forest-50 rounded-full transition-colors duration-200 text-forest-800 cursor-pointer z-10"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-7 h-7"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6 18 18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="flex flex-col pt-20 pb-8 px-6 space-y-6">
    <div class="w-full">
      <div class="relative">
        <svg
          class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-forest-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="search"
          id="mobile-search-input"
          placeholder={t(locale, "ui.search_placeholder", "Çiçek ara...")}
          class="w-full pl-12 pr-4 py-3.5 bg-forest-50/50 border border-forest-200/50 rounded-full text-sm font-medium text-neutral-700 placeholder:text-neutral-400 focus:outline-none focus:bg-white focus:border-forest-400 focus:ring-2 focus:ring-forest-100 transition-all"
        />
        <div
          id="mobile-search-results"
          class="absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-forest-100 hidden max-h-80 overflow-y-auto z-50"
        >
        </div>
      </div>
    </div>

    <div class="w-full">
      <h3
        class="text-xs uppercase tracking-widest font-bold text-forest-600 mb-3"
      >
        Özel Günler
      </h3>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2">
        <a
          href="/firsatlar/sevgiliye-cicek"
          class="flex items-center gap-2 py-2 text-sm text-neutral-700 hover:text-forest-700 transition-colors"
        >
          <span>❤️</span>
          <span class="font-medium">Sevgiliye</span>
        </a>
        <a
          href="/firsatlar/anneye-cicek"
          class="flex items-center gap-2 py-2 text-sm text-neutral-700 hover:text-forest-700 transition-colors"
        >
          <span>💐</span>
          <span class="font-medium">Anneye</span>
        </a>
        <a
          href="/firsatlar/dogum-gunu-cicekleri"
          class="flex items-center gap-2 py-2 text-sm text-neutral-700 hover:text-forest-700 transition-colors"
        >
          <span>🎂</span>
          <span class="font-medium">Doğum Günü</span>
        </a>
        <a
          href="/firsatlar/yil-donumu-cicegi"
          class="flex items-center gap-2 py-2 text-sm text-neutral-700 hover:text-forest-700 transition-colors"
        >
          <span>🥂</span>
          <span class="font-medium">Yıl Dönümü</span>
        </a>
      </div>
    </div>

    <div class="w-full pt-4 border-t border-forest-100">
      <h3
        class="text-xs uppercase tracking-widest font-bold text-forest-600 mb-3"
      >
        İletişim
      </h3>
      <div class="space-y-2 text-sm">
        <a
          href={`tel:${contactInfo.phone}`}
          class="flex items-center gap-3 text-neutral-700 hover:text-forest-700 py-2"
        >
          <span class="text-lg">📞</span>
          <span class="font-medium">{contactInfo.phoneDisplay}</span>
        </a>
        <div class="flex items-center gap-3 text-neutral-600 py-2">
          <span class="text-lg">📍</span>
          <span class="text-xs leading-relaxed"
            >{contactInfo.address.fullAddress}</span
          >
        </div>
      </div>
    </div>

    <a
      href={`https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white text-sm font-bold uppercase tracking-wider px-6 py-4 rounded-full transition-all duration-200 shadow-lg shadow-green-500/25"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
        ></path></svg
      >
      WhatsApp Sipariş
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    var header = document.getElementById("main-header");
    var headerMain = document.getElementById("header-main");
    var logo = document.getElementById("header-logo");

    window.addEventListener("scroll", function () {
      if (window.scrollY > 40) {
        headerMain.classList.remove("h-16", "lg:h-20");
        headerMain.classList.add("h-14", "lg:h-16");
        header.classList.remove("bg-white/90");
        header.classList.add("bg-white/95", "shadow-md");
        logo.classList.remove("h-12", "lg:h-16");
        logo.classList.add("h-10", "lg:h-14");
      } else {
        headerMain.classList.remove("h-14", "lg:h-16");
        headerMain.classList.add("h-16", "lg:h-20");
        header.classList.remove("bg-white/95", "shadow-md");
        header.classList.add("bg-white/90");
        logo.classList.remove("h-10", "lg:h-14");
        logo.classList.add("h-12", "lg:h-16");
      }
    });

    var mobileBtn = document.getElementById("mobile-menu-btn");
    var closeDrawer = document.getElementById("close-drawer-btn");
    var drawer = document.getElementById("mobile-drawer");

    mobileBtn.addEventListener("click", function () {
      drawer.classList.remove("translate-x-full");
    });
    closeDrawer.addEventListener("click", function () {
      drawer.classList.add("translate-x-full");
    });

    var searchInput = document.getElementById("search-input");
    var searchResults = document.getElementById("search-results");
    var products = [];
    var fuse = null;
    var fuseLoading = false;

    fetch("/api/products/search")
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        products = data;
      });

    function loadFuse(callback) {
      if (fuse) {
        callback();
        return;
      }
      if (fuseLoading) return;
      fuseLoading = true;

      var script = document.createElement("script");
      script.src =
        "https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js";
      script.onload = function () {
        fuse = new Fuse(products, {
          keys: ["name", "description", "tags"],
          threshold: 0.3,
          includeScore: true,
        });
        fuseLoading = false;
        callback();
      };
      document.head.appendChild(script);
    }

    if (searchInput) {
      searchInput.addEventListener("input", function (e) {
        var query = e.target.value.trim();
        if (!query) {
          searchResults.classList.add("hidden");
          return;
        }
        if (!fuse && products.length > 0) {
          loadFuse(function () {
            performSearch(query);
          });
        } else if (fuse) {
          performSearch(query);
        }
      });

      function performSearch(query) {
        if (!fuse) return;
        var results = fuse.search(query).slice(0, 8);
        if (results.length === 0) {
          searchResults.innerHTML =
            '<div class="p-4 text-sm text-neutral-500 text-center">Sonuç bulunamadı</div>';
        } else {
          searchResults.innerHTML = results
            .map(function (r) {
              var p = r.item;
              var img =
                (p.images && p.images[0] && p.images[0].url) || p.image || "";
              return (
                '<a href="/urun/' +
                p.slug +
                '" class="flex items-center gap-4 p-4 hover:bg-forest-50 transition-colors border-b border-forest-100 last:border-0">' +
                (img
                  ? '<img src="' +
                    img +
                    '" alt="" class="w-16 h-16 rounded-xl object-cover flex-shrink-0" />'
                  : "") +
                '<div class="flex-1 min-w-0">' +
                '<div class="text-sm font-semibold text-neutral-900 mb-1">' +
                p.name +
                "</div>" +
                '<div class="text-xs text-neutral-500 line-clamp-1">' +
                p.description +
                "</div>" +
                '<div class="text-sm text-forest-700 font-bold mt-1">' +
                p.price.toLocaleString("tr-TR") +
                " ₺</div>" +
                "</div>" +
                "</a>"
              );
            })
            .join("");
        }
        searchResults.classList.remove("hidden");
      }

      searchInput.addEventListener("blur", function () {
        setTimeout(function () {
          searchResults.classList.add("hidden");
        }, 300);
      });
    }

    var mobileSearchInput = document.getElementById("mobile-search-input");
    var mobileSearchResults = document.getElementById("mobile-search-results");

    if (mobileSearchInput) {
      mobileSearchInput.addEventListener("input", function (e) {
        var query = e.target.value.trim();
        if (!query) {
          mobileSearchResults.classList.add("hidden");
          return;
        }
        if (!fuse && products.length > 0) {
          loadFuse(function () {
            performMobileSearch(query);
          });
        } else if (fuse) {
          performMobileSearch(query);
        }
      });

      function performMobileSearch(query) {
        if (!fuse) return;
        var results = fuse.search(query).slice(0, 6);
        if (results.length === 0) {
          mobileSearchResults.innerHTML =
            '<div class="p-4 text-sm text-neutral-500 text-center">Sonuç bulunamadı</div>';
        } else {
          mobileSearchResults.innerHTML = results
            .map(function (r) {
              var p = r.item;
              var img =
                (p.images && p.images[0] && p.images[0].url) || p.image || "";
              return (
                '<a href="/urun/' +
                p.slug +
                '" class="flex items-center gap-3 p-3 hover:bg-forest-50 transition-colors border-b border-forest-100 last:border-0">' +
                (img
                  ? '<img src="' +
                    img +
                    '" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />'
                  : "") +
                '<div class="flex-1 min-w-0">' +
                '<div class="text-sm font-semibold text-neutral-900 truncate">' +
                p.name +
                "</div>" +
                '<div class="text-xs text-forest-700 font-bold">' +
                p.price.toLocaleString("tr-TR") +
                " ₺</div>" +
                "</div>" +
                "</a>"
              );
            })
            .join("");
        }
        mobileSearchResults.classList.remove("hidden");
      }
    }
  })();
</script>
