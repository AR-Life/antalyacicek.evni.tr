---
import { LOCALES, LOCALE_FLAGS, DEFAULT_LOCALE, type Locale } from "../i18n/config";

const currentLocale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;
const currentPath = Astro.url.pathname;

const options = LOCALES.map(loc => {
  let path = currentPath;
  if (loc === DEFAULT_LOCALE) {
    path = currentPath.replace(new RegExp(`^/${currentLocale}(/|$)`), '/');
  } else if (currentLocale === DEFAULT_LOCALE) {
    path = `/${loc}${currentPath === '/' ? '' : currentPath}`;
  } else {
    path = currentPath.replace(new RegExp(`^/${currentLocale}(/|$)`), `/${loc}/`);
  }
  return { value: path, label: `${LOCALE_FLAGS[loc]} ${loc.toUpperCase()}`, selected: loc === currentLocale };
});
---

<select 
  class="language-select bg-transparent border border-forest-200/50 rounded-full text-xs font-semibold text-neutral-700 py-2.5 pl-3 pr-8 focus:outline-none focus:ring-2 focus:ring-forest-100 cursor-pointer appearance-none shadow-sm transition-all hover:bg-forest-50/50"
  style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23131313%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right .7em top 50%; background-size: .65em auto;"
>
  {options.map((opt) => (
    <option value={opt.value} selected={opt.selected}>
      {opt.label}
    </option>
  ))}
</select>

<script>
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const selects = document.querySelectorAll('.language-select');
    selects.forEach(select => {
      select.addEventListener('change', (e) => {
        const url = (e.target as HTMLSelectElement).value;
        navigate(url);
      });
    });
  });
</script>
