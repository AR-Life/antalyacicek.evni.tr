---
import { SITE } from "../data/site.config";
---

<section id="teslimat" class="py-20 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
        3 Adımda WhatsApp Siparişi
      </h2>
      <p class="text-neutral-500 max-w-2xl mx-auto text-sm lg:text-base">
        Sepet yok, üyelik yok, bekleme yok. Sadece 3 adımda çiçekleriniz kapınızda.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <div class="relative text-center group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-forest-50 flex items-center justify-center group-hover:bg-forest-100 transition-colors duration-300">
          <span class="text-2xl">🌸</span>
        </div>
        <span class="absolute top-0 right-0 lg:right-[-2rem] text-6xl text-rose-100 font-display font-bold hidden md:block select-none">
          01
        </span>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Ürünü Beğen</h3>
        <p class="text-sm text-neutral-500 leading-relaxed">
          Beğendiğin ürüne tıkla, detayları incele.
        </p>
      </div>

      <div class="relative text-center group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-green-50 flex items-center justify-center group-hover:bg-green-100 transition-colors duration-300">
          <svg class="w-7 h-7 text-green-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
        </div>
        <span class="absolute top-0 right-0 lg:right-[-2rem] text-6xl text-rose-100 font-display font-bold hidden md:block select-none">
          02
        </span>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Sipariş Ver</h3>
        <p class="text-sm text-neutral-500 leading-relaxed">
          WhatsApp butonuna bas, otomatik mesajla siparişini ilet.
        </p>
      </div>

      <div class="relative text-center group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-forest-50 flex items-center justify-center group-hover:bg-forest-100 transition-colors duration-300">
          <svg class="w-7 h-7 text-forest-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
          </svg>
        </div>
        <span class="absolute top-0 right-0 lg:right-[-2rem] text-6xl text-rose-100 font-display font-bold hidden md:block select-none">
          03
        </span>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Teslim Al</h3>
        <p class="text-sm text-neutral-500 leading-relaxed">
          Çiçeklerin aynı gün kapında. Hızlı, taze ve güvenilir teslimat.
        </p>
      </div>
    </div>
  </div>
</section>
