---
import { SITE } from "../data/site.config";
import { contactInfo } from "../data/contact-info";
import { type Locale, localePath } from "../i18n/config";
import { t } from "../i18n/translations";

interface Props {
  locale?: Locale;
}
const { locale = (Astro.locals.locale as Locale) || "tr" } = Astro.props;

const waHref = `https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`;

const popularPurposes = [
  { value: 'sevgili', label: 'Sevgiliye 💕' },
  { value: 'dogum-gunu', label: 'Doğum Günü 🎂' },
  { value: 'is-terfi', label: 'Yeni İş & Terfi 💼' },
  { value: 'ozur-af', label: 'Özür & Af 🙏' },
  { value: 'anne', label: 'Anneye 🌷' },
  { value: 'yildonumu', label: 'Yıldönümü 💍' },
];

const extendedPurposes = [
  { value: 'gelin-düğün', label: 'Gelin & Düğün Buketi' },
  { value: 'hasta-ziyareti', label: 'Hasta Ziyareti & Geçmiş Olsun' },
  { value: 'yeni-bebek', label: 'Yeni Bebek Tebriki 👶' },
  { value: 'ofis-acilis', label: 'Ofis & İş yeri Açılışı' },
  { value: 'ogretmenler-gunu', label: 'Öğretmenler Günü' },
  { value: 'kadinlar-gunu', label: 'Kadınlar Günü' },
  { value: 'sevgililer-gunu', label: 'Sevgililer Günü Özel' },
  { value: 'mezuniyet', label: 'Mezuniyet Kutlaması' },
  { value: 'arkadas-surpriz', label: 'Arkadaştan Arkadaşa Sürpriz' },
  { value: 'soz-nisan', label: 'Söz & Nişan Masası Çiçeği' },
  { value: 'kurumsal-hediye', label: 'Kurumsal Hediye Aranjmanı' },
  { value: 'kiz-isteme', label: 'Ev Tanışma & Kız İsteme' },
  { value: 'cenaze-celenk', label: 'Cenaze & Çelenk Siparişi' },
  { value: 'icimden-geldi', label: 'İçimden Geldi (Neden Gerekmez) 😊' },
];

const isTR = locale === "tr";
---

<section class="relative overflow-x-hidden pt-16 lg:pt-20" aria-labelledby="hero-heading">
  <!-- Background image + overlays -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-flower.png"
      alt="Lüks kırmızı gül buketi — Antalya çiçek teslimatı"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="sync"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-forest-900/90 via-forest-900/75 to-forest-800/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-forest-900/60 via-transparent to-forest-900/30"></div>
  </div>

  <div class="relative mx-auto flex max-w-7xl flex-col gap-5 sm:gap-8 px-4 py-6 sm:px-6 sm:py-16 lg:flex-row lg:items-center lg:gap-14 lg:px-8 lg:py-24">
    <!-- Sol/Merkez: Manşet -->
    <div class="flex-1 text-center lg:text-left flex flex-col items-center lg:items-start gap-3 sm:gap-6">
      <!-- Badge -->
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-1.5 sm:px-4 sm:py-2 text-[11px] sm:text-sm font-bold tracking-wider text-white uppercase ring-1 ring-white/25 backdrop-blur-md shadow-xs">
        <span class="h-2 w-2 animate-pulse rounded-full bg-gold-400"></span>
        {t(locale, "ui.hero_badge", "45 Dakika VIP Teslimat")}
      </span>

      <h1
        id="hero-heading"
        class="text-[2rem] leading-[1.08] sm:text-4xl sm:leading-[1.12] md:text-5xl lg:text-[3.4rem] font-display font-black tracking-tight text-white"
      >
        <>
          {t(locale, "ui.hero_title_line1", "Antalya'da Aşkı Başlatın:")}
          <span class="mt-1.5 sm:mt-2 block bg-gradient-to-r from-gold-300 via-gold-400 to-rose-300 bg-clip-text text-transparent drop-shadow-xs">
            {t(locale, "ui.hero_title_line2", "45 Dakikada Lüks Çiçek Teslimatı 🌹")}
          </span>
        </>
      </h1>

      <p class="max-w-xl text-xs sm:text-base leading-relaxed text-white/85 font-normal lg:text-lg">
        {t(locale, "ui.hero_desc", "Taze kesim güller, Hollanda orkideleri ve el yapımı VIP aranjmanlar. Muratpaşa, Lara, Konyaaltı ve Kundu'ya motorlu kurye ile aynı gün kapınızda.")}
      </p>

      <!-- CTA Buttons -->
      <div class="mt-1 flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 w-full sm:w-auto lg:justify-start">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 bg-[#25D366] sm:bg-white/15 px-6 py-3.5 min-h-[46px] text-sm font-black text-white backdrop-blur-md transition-all duration-200 hover:bg-[#20bd5a] sm:hover:bg-white/25 hover:border-white/40 shadow-lg w-full sm:w-auto sm:text-base order-1 sm:order-2 active:scale-[0.98]"
        >
          <svg class="h-5 w-5 text-white sm:text-green-400 drop-shadow-xs shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          {t(locale, "ui.order_btn", "Hemen WhatsApp")}
        </a>
        <a
          href={localePath(locale, "/cicekler")}
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 px-7 py-3.5 min-h-[46px] text-sm sm:text-base font-extrabold text-forest-950 shadow-[0_4px_22px_rgba(251,191,36,0.35)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(251,191,36,0.45)] active:scale-[0.98] w-full sm:w-auto order-2 sm:order-1"
        >
          {t(locale, "ui.all_flowers", "Koleksiyonu Keşfet")}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- CRO VIP Trust Indicators -->
      <div class="mt-2 pt-3 sm:mt-4 sm:pt-4 border-t border-white/15 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-4 text-[11px] sm:text-sm font-medium w-full max-w-xl">
        <div class="flex items-center gap-1 bg-black/25 backdrop-blur-md px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-white/20 shadow-xs">
          <span class="text-gold-400 tracking-wider text-xs sm:text-sm font-serif">★★★★★</span>
          <span class="font-black text-white ml-0.5">4.9/5</span>
          <span class="text-white/75 text-[10px] sm:text-xs ml-1">{t(locale, "ui.trust_rating", "Müşteri Puanı")}</span>
        </div>
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-3.5 gap-y-1 text-white/90 text-[11px] sm:text-sm">
          <span class="flex items-center gap-1 font-medium">
            <span class="text-gold-400 font-bold">✓</span> {t(locale, "ui.trust_45min", "45 Dk Teslimat")}
          </span>
          <span class="flex items-center gap-1 font-medium">
            <span class="text-gold-400 font-bold">✓</span> {t(locale, "ui.trust_sameday", "Aynı Gün Teslimat")}
          </span>
          <span class="flex items-center gap-1 font-medium">
            <span class="text-gold-400 font-bold">✓</span> {t(locale, "ui.trust_fresh", "Taze Çiçek Garantisi")}
          </span>
          <span class="flex items-center gap-1 font-medium">
            <span class="text-gold-400 font-bold">✓</span> {t(locale, "ui.trust_secure", "Güvenli Ödeme")}
          </span>
        </div>
      </div>
    </div>

    <!-- Sağ: Super Kategori Seçici -->
    <div class="mx-auto w-full max-w-[460px] shrink-0 lg:mx-0">
        <div class="rounded-2xl border border-white/20 bg-white/95 p-3.5 shadow-2xl backdrop-blur-xl sm:rounded-3xl sm:p-6">
          <div class="mb-3 sm:mb-4 flex items-center gap-2">
            <span class="flex h-6 w-6 sm:h-8 sm:w-8 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs sm:text-sm font-bold text-white">⚡</span>
            <h2 class="text-sm sm:text-lg font-bold text-neutral-900">{t(locale, "ui.hero_form_title", "Kimin İçin / Ne İçin?")}</h2>
          </div>

          <form id="quick-order-form" class="space-y-3 sm:space-y-5" action="/cicekler" method="get">
            <!-- Popüler 6 hap -->
            <fieldset>
              <div class="grid grid-cols-3 gap-1.5 sm:gap-2" role="radiogroup" aria-label="Gönderim amacı">
                {popularPurposes.map((p, i) => (
                  <label class="group cursor-pointer">
                    <input
                      type="radio"
                      name="purpose"
                      value={p.value}
                      class="peer sr-only"
                      checked={i === 0}
                    />
                    <span class="flex min-h-[44px] sm:min-h-[52px] items-center justify-center rounded-xl border-2 border-forest-200/50 bg-forest-50/50 px-1.5 py-2 text-center text-[11px] sm:text-xs leading-tight font-semibold text-neutral-600 transition-all duration-200 peer-checked:border-forest-700 peer-checked:bg-forest-700 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-gold-400 active:scale-95 sm:rounded-2xl">
                      {t(locale, `occasion.${p.value}`, p.label)}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- +14 Diğer Accordion -->
            <details class="group cursor-pointer">
              <summary class="flex list-none min-h-[44px] items-center justify-between rounded-xl border-2 border-dashed border-forest-300/30 bg-forest-50/40 px-3 py-2 text-xs font-semibold text-neutral-500 transition-all duration-200 hover:border-forest-400/50 marker:content-none sm:px-4 sm:py-3 sm:text-sm [&::-webkit-details-marker]:hidden">
                <span>+ 14 {t(locale, "ui.other_purposes", "Diğer Gönderim Amacı")}</span>
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-forest-100 text-forest-700 transition-transform duration-200 group-open:rotate-180 sm:h-6 sm:w-6">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-3.5 sm:w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="mt-2 grid grid-cols-2 gap-1.5 sm:gap-2" role="radiogroup" aria-label="Diğer gönderim amaçları">
                {extendedPurposes.map((p) => (
                  <label class="group cursor-pointer">
                    <input
                      type="radio"
                      name="purpose"
                      value={p.value}
                      class="peer sr-only"
                    />
                    <span class="flex min-h-[44px] items-center justify-center rounded-lg border border-forest-200/40 bg-forest-50/30 px-2 py-1.5 text-center text-[10px] sm:text-[11px] leading-tight font-medium text-neutral-600 transition-all duration-200 peer-checked:border-forest-700 peer-checked:bg-forest-700 peer-checked:text-white sm:rounded-xl active:scale-95">
                      {t(locale, `occasion.${p.value}`, p.label)}
                    </span>
                  </label>
                ))}
              </div>
            </details>

            <!-- Teslimat garantisi rozeti -->
            <div class="flex items-center gap-2 rounded-xl bg-forest-50 px-3 py-2 ring-1 ring-forest-200/50 sm:gap-3 sm:px-4 sm:py-3">
              <span class="text-base sm:text-xl">⚡</span>
              <p class="text-[11px] sm:text-sm font-semibold leading-snug text-forest-700">
                {t(locale, "ui.hero_delivery_guarantee", "Tüm Antalya'da 45 Dakika VIP Kurye Teslimatı Garantilidir")}
              </p>
            </div>

            <button
              type="submit"
              class="group w-full inline-flex min-h-[46px] items-center justify-center gap-2 rounded-full bg-forest-700 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-forest-700/25 transition-all duration-200 hover:bg-forest-800 hover:-translate-y-0.5 hover:shadow-xl sm:py-3.5 sm:text-base active:scale-[0.98]"
            >
              {t(locale, "ui.hero_find_surprise", "Sevimli Sürprizi Bul & Sipariş Ver 💐")}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>
          </form>

          <p class="mt-2.5 sm:mt-3 text-center text-[10px] text-neutral-400 sm:text-xs">
            {t(locale, "ui.hero_features", "Ücretsiz kart notu · Motorlu kurye · %100 tazelik")}
          </p>
        </div>
      </div>
  </div>
</section>

<script is:inline>
(function() {
  function initHeroForm() {
    var form = document.getElementById("quick-order-form");
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    var heroToOccasionMap = {
      'sevgili': { slug: 'sevgiliye-cicek', name: 'Sevgiliye Çiçek 💕' },
      'dogum-gunu': { slug: 'dogum-gunu-cicekleri', name: 'Doğum Günü Çiçekleri 🎂' },
      'is-terfi': { slug: 'tebrik-cicekleri', name: 'Yeni İş & Terfi 💼' },
      'ozur-af': { slug: 'ozur-cicekleri', name: 'Özür & Af Çiçekleri 🙏' },
      'anne': { slug: 'anneye-cicek', name: 'Anneye Çiçek 🌷' },
      'yildonumu': { slug: 'yil-donumu-cicegi', name: 'Yıldönümü Çiçeği 💍' },
      'gelin-düğün': { slug: 'dugun-nisan-soz', name: 'Gelin & Düğün Buketleri' },
      'hasta-ziyareti': { slug: 'gecmis-olsun-cicekleri', name: 'Geçmiş Olsun Çiçekleri' },
      'yeni-bebek': { slug: 'bebek-dogum-cicekleri', name: 'Yeni Bebek Çiçekleri 👶' },
      'ofis-acilis': { slug: 'tebrik-cicekleri', name: 'Ofis & İş yeri Açılışı' },
      'ogretmenler-gunu': { slug: 'tebrik-cicekleri', name: 'Öğretmenler Günü Çiçekleri' },
      'kadinlar-gunu': { slug: 'anneye-cicek', name: 'Kadınlar Günü Özel' },
      'sevgililer-gunu': { slug: 'sevgiliye-cicek', name: 'Sevgililer Günü Özel Çiçekleri' },
      'mezuniyet': { slug: 'tebrik-cicekleri', name: 'Mezuniyet Kutlama Çiçekleri' },
      'arkadas-surpriz': { slug: 'dogum-gunu-cicekleri', name: 'Arkadaştan Arkadaşa Sürpriz' },
      'soz-nisan': { slug: 'dugun-nisan-soz', name: 'Söz & Nişan Masası Çiçeği' },
      'kurumsal-hediye': { slug: 'tebrik-cicekleri', name: 'Kurumsal Hediye Aranjmanları' },
      'kiz-isteme': { slug: 'dugun-nisan-soz', name: 'Ev Tanışma & Kız İsteme Çiçekleri' },
      'cenaze-celenk': { slug: 'tebrik-cicekleri', name: 'Çelenk ve Merasim' },
      'icimden-geldi': { slug: 'sevgiliye-cicek', name: 'İçimden Geldi Sürprizi 😊' }
    };

    form.addEventListener("submit", function(e) {
      // Eğer ana sayfada koleksiyon listesi varsa, sayfadan ayrılmadan doğrudan oraya kay ve ürünleri o amaca göre filtrele!
      var targetSection = document.getElementById('koleksiyon-listesi');
      if (targetSection) {
        e.preventDefault();
        var checkedRadio = form.querySelector('input[name="purpose"]:checked');
        var val = checkedRadio ? checkedRadio.value : "sevgili";
        var info = heroToOccasionMap[val] || { slug: "sevgiliye-cicek", name: "Sevgiliye Çiçek 💕" };
        
        var occLink = document.querySelector('a[data-marquee-slug="' + info.slug + '"]');
        if (occLink) {
          occLink.click();
        } else if (typeof window.switchCollectionTab === "function") {
          var payload = { type: 'occasion', slug: info.slug, name: info.name, id: info.slug };
          window.switchCollectionTab(payload);
          window.dispatchEvent(new CustomEvent('select-marquee-filter', { detail: payload }));
          var offset = targetSection.getBoundingClientRect().top + window.pageYOffset - 90;
          window.scrollTo({ top: offset, behavior: 'smooth' });
        }
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initHeroForm);
  document.addEventListener("astro:page-load", initHeroForm);
  initHeroForm();
})();
</script>
