---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactInfo, generateAboutPageSchema } from "../data/contact-info";
import { SITE } from "../data/site.config";
import { t } from "../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;

const pageTitle = `Hakkımızda - ${contactInfo.businessName} | ${SITE.name}`;
const pageDescription = `${contactInfo.businessName} hakkında. Antalya'nın en güvenilir çiçekçisi. Taze çiçekler, aynı gün teslimat, profesyonel hizmet.`;
const canonicalUrl = `${SITE.url}/hakkinda`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(generateAboutPageSchema())} />

  <div class="pt-28 pb-16 lg:pt-32">
    <section class="bg-gradient-to-br from-forest-50 via-white to-rose-50/30 py-12 lg:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
          {t(locale, "ui.about_us")}
        </h1>
        <p class="text-neutral-500 max-w-2xl mx-auto text-base lg:text-lg">
          {t(locale, "ui.about_intro")}
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-16 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg mx-auto">
          <div class="bg-forest-50 rounded-2xl p-6 lg:p-8 mb-8">
            <h2 class="text-2xl font-display font-bold text-forest-800 mb-4">
              {t(locale, "ui.our_story")}
            </h2>
            <p class="text-neutral-700 leading-relaxed mb-4">
              {contactInfo.businessName}, Antalya'nın en güzel çiçeklerini sevdiklerinize ulaştırmak amacıyla kuruldu. 
              Yılların verdiği tecrübe ve çiçekçilik tutkusuyla, her aranjmanımız özenle hazırlanıyor.
            </p>
            <p class="text-neutral-700 leading-relaxed">
              Taze çiçeklerimiz her gün özenle seçiliyor, profesyonel floristlerimiz tarafından 
              sanat eserine dönüştürülüyor. Aynı gün teslimat garantimizle, özel anlarınızı 
              kaçırmadan sevdiklerinize ulaştırıyoruz.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white rounded-xl p-6 border border-forest-100 shadow-sm">
              <div class="text-3xl mb-3">🌹</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">{t(locale, "ui.fresh_flowers")}</h3>
              <p class="text-sm text-neutral-600">
                {t(locale, "ui.fresh_flowers_desc")}
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-forest-100 shadow-sm">
              <div class="text-3xl mb-3">🚚</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">{t(locale, "ui.same_day_delivery")}</h3>
              <p class="text-sm text-neutral-600">
                {t(locale, "ui.same_day_delivery_desc")}
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-forest-100 shadow-sm">
              <div class="text-3xl mb-3">💐</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">{t(locale, "ui.professional_design")}</h3>
              <p class="text-sm text-neutral-600">
                {t(locale, "ui.professional_design_desc")}
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-forest-100 shadow-sm">
              <div class="text-3xl mb-3">💚</div>
              <h3 class="text-lg font-bold text-neutral-900 mb-2">{t(locale, "ui.customer_satisfaction")}</h3>
              <p class="text-sm text-neutral-600">
                {t(locale, "ui.customer_satisfaction_desc")}
              </p>
            </div>
          </div>

          <div class="bg-neutral-50 rounded-2xl p-6 lg:p-8">
            <h2 class="text-2xl font-display font-bold text-neutral-900 mb-4">
              {t(locale, "ui.why_us")}
            </h2>
            <ul class="space-y-3 text-neutral-700">
              <li class="flex items-start gap-3">
                <span class="text-forest-600 font-bold">✓</span>
                <span>{t(locale, "ui.why_same_day")}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-forest-600 font-bold">✓</span>
                <span>{t(locale, "ui.why_whatsapp")}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-forest-600 font-bold">✓</span>
                <span>{t(locale, "ui.why_24_7")}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-forest-600 font-bold">✓</span>
                <span>{t(locale, "ui.why_personalized")}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-forest-600 font-bold">✓</span>
                <span>{t(locale, "ui.why_quality")}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-forest-50/50">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-display font-bold text-neutral-900 mb-4">
          {t(locale, "ui.contact_us")}
        </h2>
        <p class="text-neutral-600 mb-6">
          {t(locale, "ui.contact_intro_2")}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/iletisim"
            class="inline-flex items-center gap-2 px-6 py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-md"
          >
            {t(locale, "ui.contact_info")}
          </a>
          <a
            href={`https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-all shadow-md"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
            {t(locale, "ui.order_via_whatsapp")}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
