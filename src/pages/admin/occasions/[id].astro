---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { occasions, occasionTranslations, languages, media } from "../../../db/schema";
import { eq, desc } from "drizzle-orm";
import EmojiPicker from "../../../components/admin/EmojiPicker.astro";

const id = Astro.params.id;

const [occ, allTrans] = await Promise.all([
  db.select().from(occasions).where(eq(occasions.id, id)).get(),
  db.select().from(occasionTranslations).where(eq(occasionTranslations.occasionId, id)).all(),
]);

if (!occ) return Astro.redirect("/admin/occasions");

const transMap = new Map(allTrans.map(t => [t.languageCode, t]));

let iconUrl = "";
if (occ.imageId) {
  const m = await db.select().from(media).where(eq(media.id, occ.imageId)).get();
  if (m) iconUrl = m.url;
}

const activeLangs = await db.select().from(languages).where(eq(languages.isActive, true)).orderBy(desc(languages.isDefault), languages.sortOrder);
---

<AdminLayout title={`Özel Gün Düzenle: ${transMap.get("tr")?.name || id}`}>
  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/admin/occasions" class="text-sm text-neutral-500 hover:text-neutral-800 flex items-center mb-2">
        &larr; Özel Günlere Dön
      </a>
      <h1 class="text-2xl font-bold text-neutral-900">Özel Gün Düzenle</h1>
    </div>
    <div class="flex gap-3">
      <a href="/admin/occasions" class="px-5 py-2.5 bg-white border border-neutral-200 text-neutral-700 font-semibold rounded-xl hover:bg-neutral-50 transition-colors">İptal</a>
      <button form="occasion-form" type="submit" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl shadow-md shadow-forest-700/20 transition-all">Güncelle</button>
    </div>
  </div>

  <form id="occasion-form" class="flex flex-col lg:flex-row gap-8 items-start">
    <div class="flex-1 space-y-8">
      
      <div class="flex gap-2 mb-2 border-b border-neutral-200 pb-px">
        {activeLangs.map((lang, index) => (
          <button 
            type="button" 
            class={`lang-tab px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors ${index === 0 ? 'border-forest-600 text-forest-700' : 'border-transparent text-neutral-500 hover:text-neutral-700'}`}
            data-target={`lang-pane-${lang.code}`}
          >
            {lang.name} ({lang.code.toUpperCase()})
          </button>
        ))}
      </div>

      {activeLangs.map((lang, index) => {
        const t = transMap.get(lang.code);
        return (
          <div id={`lang-pane-${lang.code}`} class={`lang-pane space-y-8 ${index !== 0 ? 'hidden' : ''}`}>
            
            <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
              <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Temel Bilgiler</h2>
              
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Özel Gün Adı {lang.isDefault ? '*' : ''}</label>
                  <input name={`name_${lang.code}`} type="text" value={t?.name || ""} required={lang.isDefault} placeholder="Örn: Anneler Günü" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
                </div>
              </div>
            </section>

          </div>
        );
      })}

      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Sabit İkon</h2>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">İkon veya Emoji</label>
            <input name="icon" type="text" value={iconUrl} placeholder="Seçmek için aşağıdan tıklayın" readonly class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm bg-neutral-50 cursor-pointer" />
          </div>
          <EmojiPicker target="icon" />
        </div>
      </section>
      
    </div>

    <div class="w-full lg:w-80 space-y-8">
      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-sm font-semibold text-neutral-800 mb-3 border-b border-neutral-100 pb-2">Durum & Ayarlar</h2>
        
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-neutral-500 mb-1.5 uppercase">Durum</label>
            <select name="status" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 outline-none text-sm bg-white">
              <option value="published" selected={occ.status === "published"}>Yayınlandı</option>
              <option value="draft" selected={occ.status === "draft"}>Taslak</option>
            </select>
          </div>
          <div>
             <label class="block text-xs font-semibold text-neutral-500 mb-1.5 uppercase">Sıra (Sort Order)</label>
             <input name="sortOrder" type="number" value={occ.sortOrder || 0} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 outline-none text-sm" />
          </div>
        </div>
      </section>
    </div>
  </form>

  <script>
    const entityId = window.location.pathname.split('/').pop() || '';

    const tabs = document.querySelectorAll('.lang-tab');
    const panes = document.querySelectorAll('.lang-pane');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-forest-600', 'text-forest-700');
          t.classList.add('border-transparent', 'text-neutral-500');
        });
        panes.forEach(p => p.classList.add('hidden'));

        tab.classList.remove('border-transparent', 'text-neutral-500');
        tab.classList.add('border-forest-600', 'text-forest-700');
        
        const targetId = tab.getAttribute('data-target');
        document.getElementById(targetId || '')?.classList.remove('hidden');
      });
    });

    document.getElementById('occasion-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      const activeLangs = Array.from(document.querySelectorAll('.lang-tab')).map(t => t.getAttribute('data-target')?.replace('lang-pane-', ''));
      const translations: any[] = [];
      
      activeLangs.forEach(lang => {
        if(!lang) return;
        const name = formData.get(`name_${lang}`);
        if(name) {
          translations.push({
            languageCode: lang,
            name: name,
            slug: (name as string).toLowerCase().replace(/[^a-z0-9ğüşöçı]/gi, '-').replace(/(^-|-$)+/g, '')
          });
        }
      });

      const trTranslation = translations.find(t => t.languageCode === 'tr');
      const trName = trTranslation?.name;
      const trSlug = trTranslation?.slug;
      
      const payload: any = {
        icon: formData.get('icon') || undefined,
        status: formData.get('status'),
        sortOrder: parseInt(formData.get('sortOrder') as string) || 0,
      };
      if (trName) payload.name = trName;
      if (trSlug) payload.slug = trSlug;

      const res = await fetch(`/api/occasions/${entityId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        window.location.href = '/admin/occasions';
      } else {
        showToast('Güncelleme başarısız!', 'error');
      }
    });
  </script>
  <style>
    .hidden { display: none; }
  </style>
</AdminLayout>
