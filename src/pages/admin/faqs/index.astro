---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { faqs, faqTranslations } from "../../../db/schema";
import { eq } from "drizzle-orm";
import TableActions from "../../../components/admin/TableActions.astro";

const rows = await db
  .select({
    id: faqs.id,
    question: faqTranslations.question,
    status: faqs.status,
    sortOrder: faqs.sortOrder,
  })
  .from(faqs)
  .leftJoin(faqTranslations, eq(faqs.id, faqTranslations.faqId))
  .where(eq(faqTranslations.languageCode, "tr"))
  .orderBy(faqs.sortOrder);
---

<AdminLayout title="Sıkça Sorulan Sorular">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Sıkça Sorulan Sorular</h1>
      <p class="text-sm text-neutral-500 mt-1">Toplam {rows.length} soru bulundu.</p>
    </div>
    <a href="/admin/faqs/new" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-md shadow-forest-700/20">
      + Yeni SSS Ekle
    </a>
  </div>

  <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm text-neutral-600">
      <thead class="bg-neutral-50 text-neutral-700 font-semibold border-b border-neutral-200">
        <tr>
          <th class="px-6 py-4">Soru</th>
          <th class="px-6 py-4">Durum</th>
          <th class="px-6 py-4">Sıra</th>
          <th class="px-6 py-4 text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        {rows.map(row => (
          <tr class="hover:bg-neutral-50 transition-colors">
            <td class="px-6 py-4 font-medium text-neutral-900">{row.question}</td>
            <td class="px-6 py-4">
              <span class={`px-2.5 py-1 rounded-full text-xs font-semibold ${row.status === 'published' ? 'bg-blue-50 text-blue-700' : 'bg-neutral-100 text-neutral-600'}`}>
                {row.status === 'published' ? 'Yayınlandı' : 'Taslak'}
              </span>
            </td>
            <td class="px-6 py-4">{row.sortOrder}</td>
            <TableActions editUrl={`/admin/faqs/${row.id}`} deleteId={row.id} deleteUrl={`/api/faqs/${row.id}`} deleteMessage={`"${row.question}" silinecek. Emin misiniz?`} />
          </tr>
        ))}
        {rows.length === 0 && (
          <tr>
            <td colspan="4" class="px-6 py-12 text-center text-neutral-500">
              Henüz soru eklenmemiş.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
