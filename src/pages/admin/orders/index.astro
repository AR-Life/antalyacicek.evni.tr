---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { orders, users } from "../../../db/schema";
import { desc, eq } from "drizzle-orm";

const orderList = await db
  .select({
    id: orders.id,
    orderNumber: orders.orderNumber,
    status: orders.status,
    totalAmount: orders.totalAmount,
    placedAt: orders.placedAt,
    customerName: users.firstName,
    customerLastName: users.lastName,
    customerEmail: users.email,
  })
  .from(orders)
  .leftJoin(users, eq(orders.userId, users.id))
  .orderBy(desc(orders.placedAt));
---

<AdminLayout title="Siparişler">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Sipariş Yönetimi</h1>
      <p class="text-sm text-neutral-500 mt-1">Gelen siparişleri ve durumlarını buradan takip edebilirsiniz.</p>
    </div>
  </div>

  <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm text-neutral-600">
      <thead class="bg-neutral-50 text-neutral-700 font-semibold border-b border-neutral-200">
        <tr>
          <th class="px-6 py-4">Sipariş No</th>
          <th class="px-6 py-4">Tarih</th>
          <th class="px-6 py-4">Müşteri</th>
          <th class="px-6 py-4">Tutar</th>
          <th class="px-6 py-4">Durum</th>
          <th class="px-6 py-4 text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        {orderList.map(o => {
          return (
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4 font-semibold text-neutral-900">#{o.orderNumber}</td>
              <td class="px-6 py-4 text-neutral-500">{o.placedAt ? new Date(o.placedAt).toLocaleString('tr-TR') : '-'}</td>
              <td class="px-6 py-4">
                <div class="font-medium text-neutral-900">{o.customerName} {o.customerLastName}</div>
                <div class="text-xs text-neutral-500">{o.customerEmail}</div>
              </td>
              <td class="px-6 py-4 font-semibold text-neutral-900">{o.totalAmount} ₺</td>
              <td class="px-6 py-4">
                <span class={`px-2.5 py-1 rounded-full text-xs font-semibold ${
                  o.status === 'delivered' ? 'bg-green-50 text-green-700' : 
                  o.status === 'pending' ? 'bg-amber-50 text-amber-700' : 'bg-blue-50 text-blue-700'
                }`}>
                  {o.status === 'pending' ? 'Bekliyor' : o.status === 'delivered' ? 'Teslim Edildi' : o.status}
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <a href={`/admin/orders/${o.id}`} class="text-forest-600 hover:text-forest-800 font-medium px-3 py-1.5 hover:bg-forest-50 rounded-lg transition-colors">Detay</a>
              </td>
            </tr>
          );
        })}
        {orderList.length === 0 && (
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-neutral-500">
              Henüz sipariş bulunmuyor.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
