---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { users } from "../../../db/schema";
import { eq, desc } from "drizzle-orm";

const customerList = await db
  .select({
    id: users.id,
    firstName: users.firstName,
    lastName: users.lastName,
    email: users.email,
    phone: users.phone,
    createdAt: users.createdAt,
  })
  .from(users)
  .where(eq(users.role, "customer"))
  .orderBy(desc(users.createdAt));
---

<AdminLayout title="Müşteriler">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Müşteriler</h1>
      <p class="text-sm text-neutral-500 mt-1">Sisteme kayıtlı müşterilerinizin listesi.</p>
    </div>
  </div>

  <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm text-neutral-600">
      <thead class="bg-neutral-50 text-neutral-700 font-semibold border-b border-neutral-200">
        <tr>
          <th class="px-6 py-4">Ad Soyad</th>
          <th class="px-6 py-4">E-posta</th>
          <th class="px-6 py-4">Telefon</th>
          <th class="px-6 py-4">Kayıt Tarihi</th>
          <th class="px-6 py-4 text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        {customerList.map(c => {
          return (
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4 font-semibold text-neutral-900">{c.firstName} {c.lastName}</td>
              <td class="px-6 py-4 text-neutral-500">{c.email}</td>
              <td class="px-6 py-4 text-neutral-500">{c.phone || '-'}</td>
              <td class="px-6 py-4 text-neutral-500">{c.createdAt ? new Date(c.createdAt).toLocaleDateString('tr-TR') : '-'}</td>
              <td class="px-6 py-4 text-right">
                <a href={`/admin/customers/${c.id}`} class="text-forest-600 hover:text-forest-800 font-medium px-3 py-1.5 hover:bg-forest-50 rounded-lg transition-colors">Detay</a>
              </td>
            </tr>
          );
        })}
        {customerList.length === 0 && (
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-neutral-500">
              Henüz kayıtlı müşteri bulunmuyor.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
