---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { categories, categoryTranslations, media } from "../../../db/schema";
import { eq } from "drizzle-orm";
import TableActions from "../../../components/admin/TableActions.astro";

const rows = await db
  .select({
    id: categories.id,
    name: categoryTranslations.name,
    slug: categoryTranslations.slug,
    status: categories.status,
    imageId: categories.imageId,
  })
  .from(categories)
  .leftJoin(categoryTranslations, eq(categories.id, categoryTranslations.categoryId))
  .where(eq(categoryTranslations.languageCode, "tr"));

// Get unique categories (in case of multiple translations, we filtered by tr, but just in case)
const catMap = new Map();
for (const row of rows) {
  if (!catMap.has(row.id)) catMap.set(row.id, row);
}
const catList = Array.from(catMap.values());

const allMedia = await db.select().from(media);
const mediaMap = new Map(allMedia.map(m => [m.id, m.url]));
---

<AdminLayout title="Kategori Yönetimi">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Kategoriler</h1>
      <p class="text-sm text-neutral-500 mt-1">Sitede bulunan kategorileri buradan yönetebilirsiniz.</p>
    </div>
    <a href="/admin/categories/new" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-md shadow-forest-700/20">
      + Yeni Kategori
    </a>
  </div>

  <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm text-neutral-600">
      <thead class="bg-neutral-50 text-neutral-700 font-semibold border-b border-neutral-200">
        <tr>
          <th class="px-6 py-4">İkon / Resim</th>
          <th class="px-6 py-4">Kategori Adı</th>
          <th class="px-6 py-4">URL (Slug)</th>
          <th class="px-6 py-4">Durum</th>
          <th class="px-6 py-4 text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        {catList.map(c => {
          const imgUrl = c.imageId ? (mediaMap.get(c.imageId) || '') : '';
          return (
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4">
                <div class="w-10 h-10 bg-neutral-100 rounded-lg flex items-center justify-center border border-neutral-200 p-1">
                  {imgUrl ? <img src={imgUrl} alt={c.name} class="max-w-full max-h-full object-contain" onerror="this.src='/images/placeholder.svg'" /> : <span class="text-neutral-400">?</span>}
                </div>
              </td>
              <td class="px-6 py-4 font-medium text-neutral-900">{c.name}</td>
              <td class="px-6 py-4 text-neutral-500">/{c.slug}</td>
              <td class="px-6 py-4">
                <span class={`px-2.5 py-1 rounded-full text-xs font-semibold ${c.status === 'published' ? 'bg-blue-50 text-blue-700' : 'bg-neutral-100 text-neutral-600'}`}>
                  {c.status === 'published' ? 'Yayınlandı' : 'Taslak'}
                </span>
              </td>
              <TableActions editUrl={`/admin/categories/${c.id}`} deleteId={c.id} deleteUrl={`/api/categories/${c.id}`} deleteMessage={`"${c.name}" kategorisini silmek istediğinize emin misiniz?`} />
            </tr>
          );
        })}
        {catList.length === 0 && (
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-neutral-500">Kategori bulunamadı.</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
