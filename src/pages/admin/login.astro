---
import "../../styles/global.css";
import { t } from "../../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/config";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;

const token = Astro.cookies.get("admin_token")?.value;
if (token) {
  return Astro.redirect("/admin");
}
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Giriş - Antalya Çiçek Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
</head>
<body class="bg-neutral-100 font-sans min-h-screen flex items-center justify-center p-4">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl p-8">
    <div class="text-center mb-8">
      <span class="text-4xl">🌸</span>
      <h1 class="text-2xl font-display font-bold text-neutral-900 mt-3">{t(locale, "ui.admin_panel")}</h1>
      <p class="text-sm text-neutral-500 mt-1">{t(locale, "ui.admin_welcome")}</p>
    </div>
    
    <form id="login-form" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1.5">E-posta</label>
        <input
          id="email-input"
          type="email"
          required
          placeholder="admin@antalyacicek.evni.tr"
          class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm"
        />
      </div>
      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.password_label")}</label>
        <input
          id="password-input"
          type="password"
          required
          placeholder={t(locale, "ui.enter_admin_password")}
          class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm"
        />
      </div>
      <button
        type="submit"
        class="w-full py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-lg shadow-forest-700/20 text-sm"
      >
        {t(locale, "ui.login_button")}
      </button>
      <p id="login-error" class="text-red-500 text-xs text-center hidden">{t(locale, "ui.invalid_password")}</p>
    </form>
  </div>

  <script>
    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('email-input') as HTMLInputElement;
      const pwInput = document.getElementById('password-input') as HTMLInputElement;
      const errorMsg = document.getElementById('login-error');
      
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ email: emailInput.value, password: pwInput.value }),
      });
      
      if (res.ok) {
        window.location.href = '/admin';
      } else {
        if(errorMsg) errorMsg.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
