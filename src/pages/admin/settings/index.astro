---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { organization } from "../../../db/schema";

const rows = await db.select().from(organization).limit(1);
const org = rows.length > 0 ? rows[0] : null;
---

<AdminLayout title="Genel Ayarlar">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Genel Ayarlar</h1>
      <p class="text-sm text-neutral-500 mt-1">Mağaza bilgileri ve genel sistem ayarları.</p>
    </div>
    <button form="settings-form" type="submit" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl shadow-md shadow-forest-700/20 transition-all">
      Değişiklikleri Kaydet
    </button>
  </div>

  <form id="settings-form" class="max-w-4xl space-y-8">
    
    <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Firma Bilgileri</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Marka Adı *</label>
          <input name="brandName" type="text" required value={org?.brandName || "Antalya Çiçek"} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Resmi / Yasal Unvan</label>
          <input name="legalName" type="text" value={org?.legalName || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
      </div>
    </section>

    <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">İletişim</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Telefon Numarası</label>
          <input name="phone" type="text" placeholder="0555..." value={org?.phone || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">WhatsApp Hattı</label>
          <input name="whatsapp" type="text" placeholder="90555..." value={org?.whatsapp || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">E-posta</label>
          <input name="email" type="email" value={org?.email || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Web Sitesi</label>
          <input name="website" type="text" value={org?.website || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
      </div>
    </section>
  </form>

  <script>
    document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      const payload = {
        brandName: formData.get('brandName'),
        legalName: formData.get('legalName'),
        phone: formData.get('phone'),
        whatsapp: formData.get('whatsapp'),
        email: formData.get('email'),
        website: formData.get('website'),
      };

      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        showToast('Ayarlar başarıyla kaydedildi!', 'success');
      } else {
        showToast('Kaydetme başarısız!', 'error');
      }
    });
  </script>
</AdminLayout>
