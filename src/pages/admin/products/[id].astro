---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { products, productTranslations, productVariants, categories, categoryTranslations, occasions, occasionTranslations, languages, media } from "../../../db/schema";
import { eq, desc } from "drizzle-orm";
import ImagePicker from "../../../components/admin/ImagePicker.astro";

const id = Astro.params.id;

const [prod, allTrans, variant, imageRow] = await Promise.all([
  db.select().from(products).where(eq(products.id, id)).get(),
  db.select().from(productTranslations).where(eq(productTranslations.productId, id)).all(),
  db.select().from(productVariants).where(eq(productVariants.productId, id)).get(),
  db.select({ url: media.url }).from(productVariants).leftJoin(media, eq(productVariants.imageId, media.id)).where(eq(productVariants.productId, id)).get(),
]);

if (!prod) return Astro.redirect("/admin/products");

const transMap = new Map(allTrans.map(t => [t.languageCode, t]));

const [activeLangs, cats, occs] = await Promise.all([
  db.select().from(languages).where(eq(languages.isActive, true)).orderBy(desc(languages.isDefault), languages.sortOrder),
  db.select({ id: categories.id, name: categoryTranslations.name }).from(categories).leftJoin(categoryTranslations, eq(categories.id, categoryTranslations.categoryId)).where(eq(categoryTranslations.languageCode, "tr")),
  db.select({ id: occasions.id, name: occasionTranslations.name, slug: occasionTranslations.slug }).from(occasions).leftJoin(occasionTranslations, eq(occasions.id, occasionTranslations.occasionId)).where(eq(occasionTranslations.languageCode, "tr")),
]);
---

<AdminLayout title={`Ürün Düzenle: ${transMap.get("tr")?.name || id}`}>
  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/admin/products" class="text-sm text-neutral-500 hover:text-neutral-800 flex items-center mb-2">
        &larr; Ürünlere Dön
      </a>
      <h1 class="text-2xl font-bold text-neutral-900">Ürün Düzenle</h1>
    </div>
    <div class="flex gap-3">
      <a href="/admin/products" class="px-5 py-2.5 bg-white border border-neutral-200 text-neutral-700 font-semibold rounded-xl hover:bg-neutral-50 transition-colors">İptal</a>
      <button form="product-form" type="submit" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl shadow-md shadow-forest-700/20 transition-all">Güncelle</button>
    </div>
  </div>

  <form id="product-form" class="flex flex-col lg:flex-row gap-8 items-start">
    <div class="flex-1 space-y-8">
      
      <div class="flex gap-2 mb-2 border-b border-neutral-200 pb-px">
        {activeLangs.map((lang, index) => (
          <button 
            type="button" 
            class={`lang-tab px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors ${index === 0 ? 'border-forest-600 text-forest-700' : 'border-transparent text-neutral-500 hover:text-neutral-700'}`}
            data-target={`lang-pane-${lang.code}`}
          >
            {lang.name} ({lang.code.toUpperCase()})
          </button>
        ))}
      </div>

      {activeLangs.map((lang, index) => {
        const t = transMap.get(lang.code);
        return (
          <div id={`lang-pane-${lang.code}`} class={`lang-pane space-y-8 ${index !== 0 ? 'hidden' : ''}`}>
            
            <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
              <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Genel Bilgiler</h2>
              
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Ürün Adı {lang.isDefault ? '*' : ''}</label>
                  <input name={`name_${lang.code}`} type="text" value={t?.name || ""} required={lang.isDefault} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Açıklama</label>
                  <textarea name={`description_${lang.code}`} rows="4" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm resize-none">{t?.description || ""}</textarea>
                </div>
              </div>
            </section>

            <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
              <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Arama Motoru (SEO)</h2>
              <p class="text-xs text-neutral-500 mb-4">Google sonuçlarında nasıl görüneceğini ayarlayın.</p>
              
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Meta Başlık</label>
                  <input name={`seoTitle_${lang.code}`} type="text" value={t?.metaTitle || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Meta Açıklama</label>
                  <textarea name={`seoDescription_${lang.code}`} rows="2" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm resize-none">{t?.metaDescription || ""}</textarea>
                </div>
              </div>
            </section>

          </div>
        );
      })}
      
      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Fiyat ve Stok</h2>
        
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Fiyat (₺) *</label>
            <input name="price" type="number" step="0.01" min="0" value={variant?.price || 0} required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">İndirimsiz Eski Fiyat (₺)</label>
            <input name="oldPrice" type="number" step="0.01" min="0" value={variant?.oldPrice || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">SKU (Stok Kodu)</label>
            <input name="sku" type="text" value={variant?.sku || ""} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Stok Adedi</label>
            <input name="stock" type="number" min="0" value={variant?.stock || 0} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
        </div>
      </section>
      
    </div>

    <div class="w-full lg:w-80 space-y-8">
      
      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-sm font-semibold text-neutral-800 mb-3 border-b border-neutral-100 pb-2">Durum</h2>
        <select name="status" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm bg-white">
          <option value="published" selected={prod.status === "published"}>Yayınlandı (Aktif)</option>
          <option value="draft" selected={prod.status === "draft"}>Taslak (Gizli)</option>
          <option value="archived" selected={prod.status === "archived"}>Arşivlendi</option>
        </select>
      </section>

      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-sm font-semibold text-neutral-800 mb-3 border-b border-neutral-100 pb-2">Sınıflandırma</h2>
        
        <div class="mb-4">
          <label class="block text-xs font-semibold text-neutral-500 mb-1.5 uppercase">Kategori</label>
          <select name="categoryId" required class="w-full px-4 py-2 rounded-lg border border-neutral-200 outline-none text-sm bg-white">
            <option value="">Seçiniz...</option>
            {cats.map(c => <option value={c.id} selected={c.id === prod.categoryId}>{c.name}</option>)}
          </select>
        </div>
        
        <div>
          <label class="block text-xs font-semibold text-neutral-500 mb-1.5 uppercase">Özel Günler</label>
          <div class="space-y-2 max-h-40 overflow-y-auto pr-2">
            {occs.map(o => (
              <label class="flex items-center gap-2 cursor-pointer text-sm text-neutral-700">
                <input type="checkbox" name="occasions" value={o.slug} class="w-4 h-4 rounded border-neutral-300 text-forest-700 focus:ring-forest-500" />
                {o.name}
              </label>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-sm font-semibold text-neutral-800 mb-3 border-b border-neutral-100 pb-2">Ürün Görseli</h2>
        <ImagePicker name="image" value={imageRow?.url || ""} label="Ürün Görseli" />
      </section>

    </div>
  </form>

  <script>
    const entityId = window.location.pathname.split('/').pop() || '';

    const tabs = document.querySelectorAll('.lang-tab');
    const panes = document.querySelectorAll('.lang-pane');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-forest-600', 'text-forest-700');
          t.classList.add('border-transparent', 'text-neutral-500');
        });
        panes.forEach(p => p.classList.add('hidden'));

        tab.classList.remove('border-transparent', 'text-neutral-500');
        tab.classList.add('border-forest-600', 'text-forest-700');
        
        const targetId = tab.getAttribute('data-target');
        document.getElementById(targetId || '')?.classList.remove('hidden');
      });
    });

    document.getElementById('product-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      const activeLangs = Array.from(document.querySelectorAll('.lang-tab')).map(t => t.getAttribute('data-target')?.replace('lang-pane-', ''));
      
      const translations: any[] = [];
      activeLangs.forEach(lang => {
        if(!lang) return;
        const name = formData.get(`name_${lang}`);
        if(name) {
          translations.push({
            languageCode: lang,
            name: name,
            description: formData.get(`description_${lang}`),
            seoTitle: formData.get(`seoTitle_${lang}`),
            seoDescription: formData.get(`seoDescription_${lang}`),
            slug: (name as string).toLowerCase().replace(/[^a-z0-9ğüşöçı]/gi, '-').replace(/(^-|-$)+/g, '')
          });
        }
      });
      
      const payload = {
        name: translations.find(t => t.languageCode === 'tr')?.name,
        slug: translations.find(t => t.languageCode === 'tr')?.slug,
        description: translations.find(t => t.languageCode === 'tr')?.description,
        price: parseFloat(formData.get('price') as string),
        oldPrice: formData.get('oldPrice') ? parseFloat(formData.get('oldPrice') as string) : undefined,
        categoryId: formData.get('categoryId') || undefined,
        image: formData.get('image') || undefined,
      };

      const res = await fetch(`/api/products/${entityId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        window.location.href = '/admin/products';
      } else {
        showToast('Güncelleme başarısız!', 'error');
      }
    });
  </script>
  <style>
    .hidden { display: none; }
  </style>
</AdminLayout>
