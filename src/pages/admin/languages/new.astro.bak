---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { countries } from "../../../data/countries";
import { db } from "../../../db";
import { languages } from "../../../db/schema";

const existingLangs = await db.select({ code: languages.code }).from(languages);
const existingCodes = existingLangs.map(l => l.code);

const trNames = new Intl.DisplayNames(['tr'], { type: 'language' });

// Group countries by locale
const langGroups = countries.reduce((acc, c) => {
  if (!acc[c.locale]) {
    try {
      let name = trNames.of(c.locale) || c.locale;
      name = name.charAt(0).toUpperCase() + name.slice(1);
      
      acc[c.locale] = {
        code: c.locale,
        name: name,
        countries: [],
        currencies: new Set()
      };
    } catch(e) {
      acc[c.locale] = { code: c.locale, name: c.locale.toUpperCase(), countries: [], currencies: new Set() };
    }
  }
  
  acc[c.locale].countries.push({ name: c.name, flag: c.flag });
  acc[c.locale].currencies.add(c.currency);
  return acc;
}, {} as Record<string, any>);

const availableLangs = Object.values(langGroups)
  .filter(g => !existingCodes.includes(g.code))
  .map(g => ({
    ...g,
    currencies: Array.from(g.currencies)
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'tr'));
---

<AdminLayout title="Yeni Dil Grubu">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Yeni Dil Grubu Ekle</h1>
      <p class="text-sm text-neutral-500 mt-1">Sisteme eklenecek dili arayın. Bağlı ülkeler ve para birimleri otomatik listelenir.</p>
    </div>
    <div class="flex gap-3">
      <a href="/admin/languages" class="px-5 py-2.5 bg-white border border-neutral-200 text-neutral-700 hover:bg-neutral-50 font-semibold rounded-xl shadow-sm transition-all">
        İptal
      </a>
      <button form="lang-form" type="submit" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl shadow-md shadow-forest-700/20 transition-all">
        Kaydet
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    <div class="lg:col-span-2 space-y-6">
      <section class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200">
        <h2 class="text-lg font-semibold text-neutral-800 mb-4 border-b border-neutral-100 pb-2">Dil Seçimi</h2>
        
        <div class="mb-6 relative">
          <input type="text" id="lang-search" class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 focus:border-forest-500 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm font-medium" placeholder="Dil ara... (Örn: İngilizce, en)" autocomplete="off" />
          <div id="lang-dropdown" class="absolute z-10 w-full mt-1 bg-white border border-neutral-200 rounded-xl shadow-xl max-h-64 overflow-y-auto hidden">
            {availableLangs.length === 0 && (
              <div class="px-4 py-4 text-sm text-neutral-500 text-center font-medium">Tüm diller zaten eklenmiş.</div>
            )}
            {availableLangs.map(l => (
              <div class="px-4 py-3 hover:bg-forest-50 border-b border-neutral-50 last:border-0 cursor-pointer transition-colors lang-option group" 
                   data-json={JSON.stringify(l)}>
                <div class="flex items-center justify-between">
                  <div>
                    <span class="font-bold text-neutral-800 group-hover:text-forest-700 transition-colors">{l.name}</span> 
                    <span class="text-neutral-400 font-mono text-xs ml-1 uppercase">({l.code})</span>
                  </div>
                  <span class="text-xs font-semibold bg-neutral-100 text-neutral-600 px-2 py-1 rounded-md">{l.countries.length} Ülke</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <form id="lang-form" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Dil Adı</label>
              <input id="f-name" name="name" type="text" required readonly class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-600 outline-none transition-all text-sm font-medium cursor-not-allowed" placeholder="Seçim yapınız" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Dil Kodu</label>
              <input id="f-code" name="code" type="text" required readonly class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-600 outline-none transition-all text-sm font-mono uppercase cursor-not-allowed" placeholder="Örn: TR" />
            </div>
          </div>
          
          <div class="flex items-center mt-4 p-4 bg-neutral-50 rounded-xl border border-neutral-100">
            <label class="flex items-center space-x-3 cursor-pointer w-full">
              <input type="checkbox" name="isDefault" value="true" class="w-5 h-5 text-forest-600 rounded focus:ring-forest-500 border-neutral-300" />
              <div>
                <span class="block text-sm font-bold text-neutral-800">Varsayılan Sistem Dili Yap</span>
                <span class="block text-xs text-neutral-500 mt-0.5">Sitenin ana dili olarak ayarlanır.</span>
              </div>
            </label>
          </div>
        </form>
      </section>
    </div>

    <!-- Preview Panel -->
    <div class="lg:col-span-1">
      <div id="preview-panel" class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200 sticky top-24 hidden">
        <h3 class="text-sm font-bold text-neutral-900 uppercase tracking-wider mb-4 border-b border-neutral-100 pb-2">Grup Kapsamı</h3>
        
        <div class="mb-5">
          <span class="text-xs font-semibold text-neutral-500 mb-2 block">Aktif Para Birimleri</span>
          <div id="preview-currencies" class="flex flex-wrap gap-2"></div>
        </div>

        <div>
          <span class="text-xs font-semibold text-neutral-500 mb-2 block flex items-center justify-between">
            Kapsanan Ülkeler 
            <span id="preview-count" class="bg-forest-100 text-forest-700 px-2 py-0.5 rounded-full text-[10px]"></span>
          </span>
          <div id="preview-countries" class="space-y-2 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar"></div>
        </div>
      </div>
      
      <div id="empty-state" class="bg-neutral-50 border border-neutral-200 border-dashed rounded-2xl p-8 text-center sticky top-24">
        <div class="text-4xl mb-3">🌍</div>
        <h3 class="text-sm font-bold text-neutral-700 mb-1">Önizleme</h3>
        <p class="text-xs text-neutral-500">Kapsanan ülkeleri görmek için sol taraftan bir dil seçin.</p>
      </div>
    </div>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
  </style>

  <script>
    const searchInput = document.getElementById('lang-search') as HTMLInputElement;
    const dropdown = document.getElementById('lang-dropdown');
    const options = document.querySelectorAll('.lang-option');
    const emptyState = document.getElementById('empty-state');
    const previewPanel = document.getElementById('preview-panel');
    const previewCurrencies = document.getElementById('preview-currencies');
    const previewCountries = document.getElementById('preview-countries');
    const previewCount = document.getElementById('preview-count');
    
    searchInput?.addEventListener('focus', () => dropdown?.classList.remove('hidden'));
    
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (searchInput && dropdown && !searchInput.contains(target) && !dropdown.contains(target)) {
        dropdown.classList.add('hidden');
      }
    });

    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLocaleLowerCase('tr-TR');
      dropdown?.classList.remove('hidden');
      options.forEach(opt => {
        const text = opt.textContent?.toLocaleLowerCase('tr-TR') || '';
        if (text.includes(val)) {
          (opt as HTMLElement).style.display = 'block';
        } else {
          (opt as HTMLElement).style.display = 'none';
        }
      });
    });

    options.forEach(opt => {
      opt.addEventListener('click', () => {
        const el = opt as HTMLElement;
        const data = JSON.parse(el.getAttribute('data-json') || '{}');
        
        if(searchInput) searchInput.value = data.name + ' (' + data.code.toUpperCase() + ')';
        dropdown?.classList.add('hidden');
        
        (document.getElementById('f-name') as HTMLInputElement).value = data.name; 
        (document.getElementById('f-code') as HTMLInputElement).value = data.code;

        // Render Preview
        if(emptyState) emptyState.classList.add('hidden');
        if(previewPanel) previewPanel.classList.remove('hidden');
        
        if(previewCount) previewCount.textContent = data.countries.length;
        
        if(previewCurrencies) {
          previewCurrencies.innerHTML = data.currencies.map((c: string) => 
            '<' + 'span class="bg-blue-50 text-blue-700 font-mono text-xs font-bold px-2.5 py-1 rounded-md border border-blue-100">' + c + '<' + '/span>'
          ).join('');
        }

        if(previewCountries) {
          previewCountries.innerHTML = data.countries.map((c: any) => 
            '<' + 'div class="flex items-center p-2 bg-neutral-50 rounded-lg border border-neutral-100 hover:border-neutral-200 transition-colors">' +
              '<' + 'span class="text-xl mr-3 shadow-sm rounded-sm">' + c.flag + '<' + '/span>' +
              '<' + 'span class="text-sm font-medium text-neutral-700">' + c.name + '<' + '/span>' +
            '<' + '/div>'
          ).join('');
        }
      });
    });

    document.getElementById('lang-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      if (!formData.get('code')) {
        alert("Lütfen listeden bir dil seçiniz.");
        return;
      }
      
      const payload = {
        name: formData.get('name'),
        code: formData.get('code'),
        isDefault: formData.get('isDefault') === 'true'
      };

      const res = await fetch('/api/languages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if(res.ok) {
        window.location.href = '/admin/languages';
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Dil eklenirken bir hata oluştu.');
      }
    });
  </script>
</AdminLayout>
