---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../db";
import { languages } from "../../../db/schema";
import { desc } from "drizzle-orm";
import { countries } from "../../../data/countries";

const languageList = await db.select().from(languages).orderBy(desc(languages.isDefault), languages.sortOrder);

// Yardımcı fonksiyon: Bir dil koduna ait ülke sayısını hesapla
const getCountryCount = (code: string) => countries.filter(c => c.locale === code).length;

---

<AdminLayout title="Diller">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Dil Grupları</h1>
      <p class="text-sm text-neutral-500 mt-1">Sisteme eklediğiniz her dil, otomatik olarak kendi ülkelerini, bayraklarını ve para birimlerini aktif eder.</p>
    </div>
    <a href="/admin/languages/new" class="px-5 py-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl shadow-md shadow-forest-700/20 transition-all flex items-center">
      <span class="mr-2 text-lg">+</span> Yeni Dil Ekle
    </a>
  </div>

  <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left text-sm text-neutral-600">
      <thead class="bg-neutral-50 text-neutral-700 font-semibold border-b border-neutral-200">
        <tr>
          <th class="px-6 py-4">Dil Grubu</th>
          <th class="px-6 py-4">Kod</th>
          <th class="px-6 py-4">Kapsanan Ülke Sayısı</th>
          <th class="px-6 py-4">Durum</th>
          <th class="px-6 py-4 text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100">
        {languageList.map((lang) => (
          <tr class="hover:bg-neutral-50 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div>
                  <div class="font-bold text-neutral-900">{lang.name}</div>
                  {lang.isDefault && <div class="text-[10px] uppercase font-bold text-forest-600 tracking-wider">Varsayılan</div>}
                </div>
              </div>
            </td>
            <td class="px-6 py-4 font-mono font-semibold text-neutral-800">{lang.code.toUpperCase()}</td>
            <td class="px-6 py-4 text-sm text-neutral-500">
              <span class="inline-flex items-center justify-center px-2 py-1 bg-neutral-100 text-neutral-700 font-semibold rounded-md mr-2">
                {getCountryCount(lang.code)}
              </span>
              Ülke / Pazar
            </td>
            <td class="px-6 py-4">
              <span class={`px-2.5 py-1 rounded-full text-xs font-semibold ${
                lang.isActive ? 'bg-green-50 text-green-700' : 'bg-neutral-100 text-neutral-600'
              }`}>
                {lang.isActive ? 'Aktif' : 'Pasif'}
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <button data-id={lang.id} class="delete-btn text-red-500 hover:text-red-700 font-medium px-3 py-1.5 hover:bg-red-50 rounded-lg transition-colors">Sil</button>
            </td>
          </tr>
        ))}
        {languageList.length === 0 && (
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-neutral-500">
              Henüz bir dil eklenmemiş. Lütfen sistem için varsayılan bir dil ekleyin.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

  <script>
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
        if (!id) return;
        
        window.showConfirm(
          'Dili Sil',
          'Bu dili silmek istediğinize emin misiniz? Sitedeki bazı içeriklerin çevirileri bozulabilir.',
          'Evet, Sil',
          async () => {
            const res = await fetch(`/api/languages/${id}`, {
              method: 'DELETE',
            });
            
            if (res.ok) {
              window.location.reload();
            } else {
              const data = await res.json().catch(() => ({}));
              showToast(data.error || 'Dil silinirken bir hata oluştu.', 'error');
            }
          }
        );
      });
    });
  </script>
</AdminLayout>
