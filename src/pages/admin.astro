---
import "../styles/global.css";
import { categories } from "../data/categories";
import { occasions } from "../data/occasions";
import { t } from "../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;

const categoriesJson = JSON.stringify(
  categories.map((c) => ({ id: c.id, name: c.name }))
);
const occasionsJson = JSON.stringify(
  occasions.map((o) => ({ id: o.id, name: o.name, slug: o.slug, icon: o.icon }))
);
const translationsJson = JSON.stringify({
  geersiz_ifre: t(locale, "ui.invalid_password"),
  rn_bulundu: t(locale, "ui.products_found"),
  henz_rn_eklenmedi: t(locale, "ui.no_products_yet"),
  dzenle: t(locale, "ui.edit_button"),
  sil: t(locale, "ui.delete_button"),
  bu_rn_silmek_istediinize: t(locale, "ui.confirm_delete"),
  silme_baarsz: t(locale, "ui.delete_failed"),
});
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin - Antalya Çiçek</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
</head>
<body class="bg-neutral-100 font-sans min-h-screen">

<div id="app" class="min-h-screen flex flex-col">
  <!-- Login Screen -->
  <div id="login-screen" class="flex-1 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl p-8">
      <div class="text-center mb-8">
        <span class="text-4xl">🌸</span>
        <h1 class="text-2xl font-display font-bold text-neutral-900 mt-3">{t(locale, "ui.admin_panel")}</h1>
        <p class="text-sm text-neutral-500 mt-1">{t(locale, "ui.admin_welcome")}</p>
      </div>
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.password_label")}</label>
          <input
            id="password-input"
            type="password"
            required
            placeholder={t(locale, "ui.enter_admin_password")}
            class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm"
          />
        </div>
        <button
          type="submit"
          class="w-full py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-lg shadow-forest-700/20 text-sm"
        >
          {t(locale, "ui.login_button")}
        </button>
        <p id="login-error" class="text-red-500 text-xs text-center hidden"></p>
      </form>
    </div>
  </div>

  <!-- Dashboard Screen -->
  <div id="dashboard-screen" class="hidden">
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🌸</span>
          <h1 class="font-display font-bold text-lg text-neutral-900">{t(locale, "ui.product_management")}</h1>
        </div>
        <div class="flex items-center gap-4">
          <button id="add-product-btn" class="add-action-btn px-4 py-2 bg-forest-700 hover:bg-forest-800 text-white text-sm font-semibold rounded-xl transition-all shadow-md shadow-forest-700/20">
            + {t(locale, "ui.add_new_product")}
          </button>
          <button id="logout-btn" class="text-sm text-neutral-500 hover:text-red-500 transition-colors">
            {t(locale, "ui.logout")}
          </button>
        </div>
      </div>
      <div class="border-t border-neutral-200">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 flex gap-6">
          <button class="admin-tab-btn active px-1 py-3 text-sm font-semibold text-forest-700 border-b-2 border-forest-700" data-tab="products">Ürünler</button>
          <button class="admin-tab-btn px-1 py-3 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent transition-colors" data-tab="categories">Kategoriler</button>
          <button class="admin-tab-btn px-1 py-3 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent transition-colors" data-tab="occasions">Özel Günler</button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 sm:px-6 py-8">
      <!-- PRODUCTS TAB -->
      <div id="tab-content-products" class="admin-tab-content">
        <div id="product-count" class="text-sm text-neutral-500 mb-4"></div>
        <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

      <!-- CATEGORIES TAB -->
      <div id="tab-content-categories" class="admin-tab-content hidden">
        <div class="flex items-center justify-between mb-4">
          <div id="category-count" class="text-sm text-neutral-500"></div>
          <button id="add-category-btn" class="px-3 py-1.5 bg-forest-700 hover:bg-forest-800 text-white text-xs font-semibold rounded-lg transition-all shadow-sm">+ Yeni Kategori</button>
        </div>
        <div id="category-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

      <!-- OCCASIONS TAB -->
      <div id="tab-content-occasions" class="admin-tab-content hidden">
        <div class="flex items-center justify-between mb-4">
          <div id="occasion-count" class="text-sm text-neutral-500"></div>
          <button id="add-occasion-btn" class="px-3 py-1.5 bg-forest-700 hover:bg-forest-800 text-white text-xs font-semibold rounded-lg transition-all shadow-sm">+ Yeni Özel Gün</button>
        </div>
        <div id="occasion-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </main>
  </div>

  <!-- Add/Edit Modal -->
  <div id="product-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 lg:p-8">
      <h2 id="modal-title-text" class="text-xl font-display font-bold text-neutral-900 mb-6">{t(locale, "ui.new_product")}</h2>
      
      <form id="product-form" class="space-y-5">
        <input type="hidden" id="edit-id" value="" />

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.product_name_label")}</label>
          <input id="input-name" type="text" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.category_label")}</label>
          <select id="input-category" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm bg-white">
            <option value="">{t(locale, "ui.select_option")}</option>
            {categories.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.description_label")}</label>
          <textarea id="input-desc" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm resize-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.price_label")}</label>
            <input id="input-price" type="number" step="0.01" min="0" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" oninput="calcDiscount()" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.old_price_label")}</label>
            <input id="input-oldprice" type="number" step="0.01" min="0" placeholder={t(locale, "ui.leave_empty_no_discount")} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" oninput="calcDiscount()" />
            <span id="discount-preview" class="text-xs text-forest-700 font-semibold mt-1 hidden"></span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.brand_label")}</label>
            <input id="input-brand" type="text" value="Antalya Çiçek" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.stock_status_label")}</label>
            <select id="input-availability" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm bg-white">
              <option value="InStock">{t(locale, "ui.in_stock")}</option>
              <option value="OutOfStock">{t(locale, "ui.out_of_stock")}</option>
              <option value="PreOrder">{t(locale, "ui.pre_order")}</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.tags_label")}</label>
          <input id="input-tags" type="text" placeholder={t(locale, "ui.tags_example")} class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.occasions_label")}</label>
          <div id="occasions-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2 p-3 bg-neutral-50 rounded-xl border border-neutral-200 max-h-48 overflow-y-auto">
            {occasions.map((o) => (
              <label class="flex items-center gap-2 cursor-pointer hover:bg-white rounded-lg p-1.5 transition-colors">
                <input type="checkbox" name="occasion" value={o.slug} class="occasion-checkbox w-4 h-4 rounded border-neutral-300 text-forest-700 focus:ring-forest-400" />
                <span class="text-xs text-neutral-700 truncate">{o.icon} {o.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.gtin_label")}</label>
            <input id="input-gtin" type="text" placeholder="8681234567890" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.mpn_label")}</label>
            <input id="input-mpn" type="text" placeholder="AC-001" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{t(locale, "ui.images_label")}</label>
          <div id="images-preview" class="flex flex-wrap gap-3 mb-3"></div>
          <label class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-100 hover:bg-neutral-200 rounded-xl cursor-pointer transition-all text-sm font-medium text-neutral-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            {t(locale, "ui.upload_image")}
            <input type="file" id="input-images" multiple accept="image/*" class="hidden" />
          </label>
          <span id="upload-status" class="text-xs text-neutral-500 ml-3"></span>
        </div>

        <div class="flex items-center gap-3">
          <input type="checkbox" id="input-featured" class="w-4 h-4 rounded border-neutral-300 text-forest-700 focus:ring-forest-400" />
          <label for="input-featured" class="text-sm text-neutral-700">{t(locale, "ui.featured_product_checkbox")}</label>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="submit" class="flex-1 py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-lg shadow-forest-700/20 text-sm">
            {t(locale, "ui.save_button")}
          </button>
          <button type="button" id="modal-cancel" class="px-6 py-3 bg-neutral-100 hover:bg-neutral-200 text-neutral-600 font-semibold rounded-xl transition-all text-sm">
            {t(locale, "ui.cancel_button")}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="category-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="category-modal-backdrop"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-6 lg:p-8">
      <h2 id="category-modal-title" class="text-xl font-display font-bold text-neutral-900 mb-6">Yeni Kategori</h2>
      <form id="category-form" class="space-y-5">
        <input type="hidden" id="cat-edit-id" value="" />
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Kategori Adı</label>
          <input id="cat-input-name" type="text" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Slug (URL)</label>
          <input id="cat-input-slug" type="text" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Açıklama</label>
          <textarea id="cat-input-desc" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm resize-none"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Kategori Resmi / İkonu (SVG veya WebP)</label>
          <div class="flex gap-3 mb-2">
            <input id="cat-input-image" type="text" placeholder="/images/ornek.svg" required class="flex-1 px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
            <label class="inline-flex items-center justify-center px-4 bg-neutral-100 hover:bg-neutral-200 rounded-xl cursor-pointer transition-all text-sm font-medium text-neutral-600 border border-neutral-200 whitespace-nowrap">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Yükle
              <input type="file" id="cat-upload-image" accept="image/*" class="hidden" />
            </label>
          </div>
          <span id="cat-upload-status" class="text-xs text-neutral-500"></span>
          <div id="cat-image-preview-container" class="mt-2 hidden">
            <img id="cat-image-preview" src="" class="w-16 h-16 object-cover rounded-xl border border-neutral-200" />
          </div>
        </div>
        <div class="flex gap-3 pt-4">
          <button type="submit" class="flex-1 py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-lg shadow-forest-700/20 text-sm">Kaydet</button>
          <button type="button" id="cat-modal-cancel" class="px-6 py-3 bg-neutral-100 hover:bg-neutral-200 text-neutral-600 font-semibold rounded-xl transition-all text-sm">İptal</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Occasion Modal -->
  <div id="occasion-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="occasion-modal-backdrop"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-6 lg:p-8">
      <h2 id="occasion-modal-title" class="text-xl font-display font-bold text-neutral-900 mb-6">Yeni Özel Gün</h2>
      <form id="occasion-form" class="space-y-5">
        <input type="hidden" id="occ-edit-id" value="" />
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Özel Gün Adı</label>
          <input id="occ-input-name" type="text" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Slug (URL)</label>
          <input id="occ-input-slug" type="text" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Açıklama</label>
          <textarea id="occ-input-desc" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm resize-none"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-neutral-700 mb-1.5">İkon (Emoji)</label>
          <input id="occ-input-icon" type="text" placeholder="🎉" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 outline-none transition-all text-sm" />
        </div>
        <div class="flex gap-3 pt-4">
          <button type="submit" class="flex-1 py-3 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-xl transition-all shadow-lg shadow-forest-700/20 text-sm">Kaydet</button>
          <button type="button" id="occ-modal-cancel" class="px-6 py-3 bg-neutral-100 hover:bg-neutral-200 text-neutral-600 font-semibold rounded-xl transition-all text-sm">İptal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="categories-data" data-categories={categoriesJson} class="hidden"></div>
<div id="occasions-data" data-occasions={occasionsJson} class="hidden"></div>
<div id="translations-data" data-translations={translationsJson} class="hidden"></div>

<script is:inline>
var CATEGORIES = JSON.parse(document.getElementById('categories-data').dataset.categories);
var OCCASIONS = JSON.parse(document.getElementById('occasions-data').dataset.occasions);
var TRANSLATIONS = JSON.parse(document.getElementById('translations-data').dataset.translations);

var products = [];
var currentImages = [];
var editingId = null;

function $id(id) { return document.getElementById(id); }

$id('login-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  var pw = $id('password-input').value;
  var res = await fetch('/api/auth', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({password: pw}),
  });
  if (res.ok) {
    $id('login-screen').classList.add('hidden');
    $id('dashboard-screen').classList.remove('hidden');
    loadProducts();
  } else {
    $id('login-error').classList.remove('hidden');
    $id('login-error').textContent = TRANSLATIONS.geersiz_ifre;
  }
});

$id('logout-btn').addEventListener('click', function() {
  document.cookie = 'admin_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
  location.reload();
});

async function loadProducts() {
  var res = await fetch('/api/products');
  products = await res.json();
  renderList();
}

function renderList() {
  var container = $id('product-list');
  var count = $id('product-count');
  count.textContent = products.length + ' ' + TRANSLATIONS.rn_bulundu;

  if (products.length === 0) {
    container.innerHTML = '<p class="col-span-full text-center text-neutral-400 py-12">' + TRANSLATIONS.henz_rn_eklenmedi + '</p>';
    return;
  }

  container.innerHTML = products.map(function(p) {
    var cat = CATEGORIES.find(function(c) { return c.id === p.categoryId; });
    var img = (p.images && p.images[0] && p.images[0].url) || 'https://placehold.co/400x500/f5f5f5/fda4af?text=No+Image';
    var hasDiscount = p.oldPrice && p.oldPrice > p.price;
    var discountPct = hasDiscount ? Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100) : 0;
    return '<div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden group">'+
      '<div class="aspect-[4/5] bg-neutral-50 overflow-hidden relative">'+
        '<img src="'+img+'" alt="'+p.name+'" class="w-full h-full object-cover" />'+
        (hasDiscount ? '<span class="absolute top-3 left-3 px-2.5 py-1 bg-forest-700 text-white text-[11px] font-bold rounded-full shadow-lg shadow-forest-700/30">%'+discountPct+' İndirim</span>' : '')+
      '</div>'+
      '<div class="p-4">'+
        (hasDiscount ? '<div class="flex items-baseline gap-2 mb-2"><span class="text-xs font-bold text-forest-700">%'+discountPct+' indirimli</span></div>' : '')+
        '<div class="flex gap-1 mb-2">'+
          ((p.tags||[]).slice(0,3).map(function(t){return '<span class="text-[10px] px-2 py-0.5 bg-forest-50 text-forest-800 rounded-full">'+t+'</span>';}).join('') || '')+
        '</div>'+
        '<h3 class="text-sm font-semibold text-neutral-900 mb-1 line-clamp-2">'+p.name+'</h3>'+
        '<p class="text-[11px] text-neutral-400 mb-2">'+(cat ? cat.name : 'Kategorisiz')+'</p>'+
        '<div class="flex items-baseline gap-2 mb-1">'+
          '<span class="text-base font-bold text-neutral-900">'+p.price.toLocaleString('tr-TR', {minimumFractionDigits: 2})+' ₺</span>'+
          (hasDiscount ? '<span class="text-xs text-neutral-400 line-through">'+p.oldPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2})+' ₺</span>' : '')+
        '</div>'+
        '<div class="flex gap-2 mt-3">'+
          '<button onclick="editProduct(\''+p.id+'\')" class="flex-1 py-2 bg-neutral-100 hover:bg-neutral-200 text-neutral-600 text-xs font-semibold rounded-lg transition-all">'+TRANSLATIONS.dzenle+'</button>'+
          '<button onclick="deleteProduct(\''+p.id+'\')" class="py-2 px-3 bg-red-50 hover:bg-red-100 text-red-500 text-xs font-semibold rounded-lg transition-all">'+TRANSLATIONS.sil+'</button>'+
        '</div>'+
      '</div>'+
    '</div>';
  }).join('');
}

var modal = $id('product-modal');
var backdrop = $id('modal-backdrop');
var cancelBtn = $id('modal-cancel');

function openModal(title) {
  $id('modal-title-text').textContent = title;
  modal.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  modal.classList.add('hidden');
  document.body.style.overflow = '';
  resetForm();
}

backdrop.addEventListener('click', closeModal);
cancelBtn.addEventListener('click', closeModal);

$id('add-product-btn').addEventListener('click', function() {
  editingId = null;
  currentImages = [];
  openModal('Yeni Ürün');
});

$id('input-images').addEventListener('change', async function(e) {
  var files = e.target.files;
  if (!files || files.length === 0) return;

  var status = $id('upload-status');
  status.textContent = 'Yükleniyor...';

  var formData = new FormData();
  for (var f of files) formData.append('files', f);

  try {
    var res = await fetch('/api/upload', { method: 'POST', body: formData });
    var data = await res.json();
    if (data.urls) {
      data.urls.forEach(function(url) { currentImages.push({ url: url, alt: '' }); });
      renderImagePreviews();
      status.textContent = data.urls.length + ' görsel yüklendi';
    }
  } catch (err) {
    status.textContent = 'Yükleme başarısız!';
  }
  e.target.value = '';
});

function renderImagePreviews() {
  var container = $id('images-preview');
  container.innerHTML = currentImages.map(function(img, i) {
    return '<div class="relative w-20 h-20 rounded-xl overflow-hidden border-2 border-neutral-100 group/img">'+
      '<img src="'+img.url+'" alt="" class="w-full h-full object-cover" />'+
      '<button onclick="removeImage('+i+')" class="absolute top-1 right-1 w-5 h-5 bg-red-500 text-white rounded-full flex items-center justify-center text-[10px] opacity-0 group-hover/img:opacity-100 transition-opacity">&times;</button>'+
    '</div>';
  }).join('');
}

window.removeImage = function(i) {
  currentImages.splice(i, 1);
  renderImagePreviews();
};

$id('product-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  var nameVal = $id('input-name').value;
  var oldPriceVal = $id('input-oldprice').value;

  var data = {
    name: nameVal,
    slug: slugify(nameVal),
    description: $id('input-desc').value,
    price: parseFloat($id('input-price').value),
    categoryId: $id('input-category').value,
    images: currentImages,
    tags: $id('input-tags').value.split(',').map(function(t) { return t.trim(); }).filter(Boolean),
    occasions: Array.from(document.querySelectorAll('.occasion-checkbox:checked')).map(function(cb) { return cb.value; }),
    brand: $id('input-brand').value,
    availability: $id('input-availability').value,
    condition: 'new',
    featured: $id('input-featured').checked,
    gtin: $id('input-gtin').value || '',
    mpn: $id('input-mpn').value || '',
  };

  if (oldPriceVal) data.oldPrice = parseFloat(oldPriceVal);

  var url = editingId ? '/api/products/' + editingId : '/api/products';
  var method = editingId ? 'PUT' : 'POST';

  var res = await fetch(url, {
    method: method,
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data),
  });

  if (res.ok) {
    closeModal();
    loadProducts();
  } else {
    alert('Kaydetme başarısız!');
  }
});

window.editProduct = function(id) {
  var p = products.find(function(x) { return x.id === id; });
  if (!p) return;
  
  editingId = id;
  currentImages = (p.images || []).slice();
  
  $id('input-name').value = p.name;
  $id('input-category').value = p.categoryId;
  $id('input-desc').value = p.description;
  $id('input-price').value = String(p.price);
  $id('input-oldprice').value = p.oldPrice ? String(p.oldPrice) : '';
  $id('input-tags').value = (p.tags || []).join(', ');
  $id('input-brand').value = p.brand;
  $id('input-availability').value = p.availability;
  $id('input-featured').checked = p.featured;
  $id('input-gtin').value = p.gtin || '';
  $id('input-mpn').value = p.mpn || '';
  
  document.querySelectorAll('.occasion-checkbox').forEach(function(cb) {
    cb.checked = (p.occasions || []).includes(cb.value);
  });
  
  renderImagePreviews();
  calcDiscount();
  openModal('Ürünü Düzenle');
};

window.deleteProduct = async function(id) {
  if (!confirm(TRANSLATIONS.bu_rn_silmek_istediinize)) return;
  var res = await fetch('/api/products/' + id, { method: 'DELETE' });
  if (res.ok) loadProducts();
  else alert(TRANSLATIONS.silme_baarsz);
};

function slugify(text) {
  return text.toLowerCase()
    .replace(/[ğ]/g, 'g').replace(/[ü]/g, 'u').replace(/[ş]/g, 's')
    .replace(/[ı]/g, 'i').replace(/[ö]/g, 'o').replace(/[ç]/g, 'c')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

function calcDiscount() {
  var price = parseFloat($id('input-price').value) || 0;
  var old = parseFloat($id('input-oldprice').value) || 0;
  var span = $id('discount-preview');
  if (old > 0 && price > 0 && old > price) {
    var pct = Math.round(((old - price) / old) * 100);
    span.textContent = '%' + pct + ' indirim';
    span.classList.remove('hidden');
  } else {
    span.classList.add('hidden');
  }
}
window.calcDiscount = calcDiscount;

function resetForm() {
  $id('product-form').reset();
  currentImages = [];
  editingId = null;
  document.querySelectorAll('.occasion-checkbox').forEach(function(cb) { cb.checked = false; });
  renderImagePreviews();
  $id('upload-status').textContent = '';
  $id('discount-preview').classList.add('hidden');
}

// ----------------------------------------------------
// TABS & NEW SECTIONS LOGIC
// ----------------------------------------------------

var currentTab = 'products';

document.querySelectorAll('.admin-tab-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.admin-tab-btn').forEach(b => {
      b.classList.remove('active', 'text-forest-700', 'border-forest-700');
      b.classList.add('text-neutral-500', 'border-transparent');
    });
    this.classList.remove('text-neutral-500', 'border-transparent');
    this.classList.add('active', 'text-forest-700', 'border-forest-700');
    
    document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.add('hidden'));
    currentTab = this.dataset.tab;
    $id('tab-content-' + currentTab).classList.remove('hidden');

    if (currentTab === 'products') loadProducts();
    if (currentTab === 'categories') loadCategories();
    if (currentTab === 'occasions') loadOccasions();
  });
});

// Category Logic
var _categories = [];
async function loadCategories() {
  var res = await fetch('/api/categories');
  if (!res.ok) return;
  _categories = await res.json();
  renderCategories();
}

function renderCategories() {
  $id('category-count').textContent = _categories.length + ' Kategori bulundu.';
  $id('category-list').innerHTML = _categories.map(function(c) {
    return `
      <div class="bg-white rounded-2xl border border-neutral-200 p-4 shadow-sm flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-neutral-50 rounded-lg flex items-center justify-center p-2 border border-neutral-100">
             <img src="${c.image}" class="max-w-full max-h-full object-contain" onerror="this.src='/images/placeholder.svg'" />
          </div>
          <div>
            <h3 class="font-bold text-neutral-800 text-sm">${c.name}</h3>
            <p class="text-xs text-neutral-500 truncate max-w-[150px]">${c.slug}</p>
          </div>
        </div>
        <div class="flex gap-2">
          <button onclick="editCategory('${c.id}')" class="p-2 text-blue-500 hover:bg-blue-50 rounded-lg transition-colors">✏️</button>
          <button onclick="deleteCategory('${c.id}')" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors">🗑️</button>
        </div>
      </div>
    `;
  }).join('');
}

$id('category-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  var editId = $id('cat-edit-id').value;
  var data = {
    name: $id('cat-input-name').value,
    slug: slugify($id('cat-input-slug').value),
    description: $id('cat-input-desc').value,
    image: $id('cat-input-image').value,
  };
  var url = editId ? '/api/categories/' + editId : '/api/categories';
  var method = editId ? 'PUT' : 'POST';

  var res = await fetch(url, {
    method: method,
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data),
  });

  if (res.ok) {
    closeCategoryModal();
    loadCategories();
  } else {
    alert('Kaydetme başarısız!');
  }
});

window.editCategory = function(id) {
  var c = _categories.find(x => x.id === id);
  if (!c) return;
  $id('cat-edit-id').value = id;
  $id('cat-input-name').value = c.name;
  $id('cat-input-slug').value = c.slug;
  $id('cat-input-desc').value = c.description || '';
  $id('cat-input-image').value = c.image || '';
  
  if (c.image) {
    $id('cat-image-preview').src = c.image;
    $id('cat-image-preview-container').classList.remove('hidden');
  } else {
    $id('cat-image-preview-container').classList.add('hidden');
  }
  
  $id('category-modal-title').textContent = 'Kategori Düzenle';
  $id('category-modal').classList.remove('hidden');
};

$id('cat-upload-image').addEventListener('change', async function(e) {
  var files = e.target.files;
  if (!files || files.length === 0) return;

  var status = $id('cat-upload-status');
  status.textContent = 'Yükleniyor...';

  var formData = new FormData();
  formData.append('files', files[0]); // Sadece tek resim

  try {
    var res = await fetch('/api/upload', { method: 'POST', body: formData });
    var data = await res.json();
    if (data.urls && data.urls.length > 0) {
      $id('cat-input-image').value = data.urls[0];
      $id('cat-image-preview').src = data.urls[0];
      $id('cat-image-preview-container').classList.remove('hidden');
      status.textContent = 'Görsel yüklendi';
    }
  } catch (err) {
    status.textContent = 'Yükleme başarısız!';
  }
  e.target.value = '';
});

window.deleteCategory = async function(id) {
  if (!confirm('Bu kategoriyi silmek istediğinize emin misiniz?')) return;
  var res = await fetch('/api/categories/' + id, { method: 'DELETE' });
  if (res.ok) loadCategories();
};

function openCategoryModal() {
  $id('category-form').reset();
  $id('cat-edit-id').value = '';
  $id('cat-image-preview-container').classList.add('hidden');
  $id('cat-image-preview').src = '';
  $id('cat-upload-status').textContent = '';
  $id('category-modal-title').textContent = 'Yeni Kategori';
  $id('category-modal').classList.remove('hidden');
}

function closeCategoryModal() {
  $id('category-modal').classList.add('hidden');
}

if ($id('add-category-btn')) $id('add-category-btn').addEventListener('click', openCategoryModal);
$id('cat-modal-cancel').addEventListener('click', closeCategoryModal);
$id('category-modal-backdrop').addEventListener('click', closeCategoryModal);

// Occasion Logic
var _occasions = [];
async function loadOccasions() {
  var res = await fetch('/api/occasions');
  if (!res.ok) return;
  _occasions = await res.json();
  renderOccasions();
}

function renderOccasions() {
  $id('occasion-count').textContent = _occasions.length + ' Özel Gün bulundu.';
  $id('occasion-list').innerHTML = _occasions.map(function(o) {
    return `
      <div class="bg-white rounded-2xl border border-neutral-200 p-4 shadow-sm flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-neutral-50 rounded-lg flex items-center justify-center text-2xl border border-neutral-100">
             ${o.icon}
          </div>
          <div>
            <h3 class="font-bold text-neutral-800 text-sm">${o.name}</h3>
            <p class="text-xs text-neutral-500 truncate max-w-[150px]">${o.slug}</p>
          </div>
        </div>
        <div class="flex gap-2">
          <button onclick="editOccasion('${o.id}')" class="p-2 text-blue-500 hover:bg-blue-50 rounded-lg transition-colors">✏️</button>
          <button onclick="deleteOccasion('${o.id}')" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors">🗑️</button>
        </div>
      </div>
    `;
  }).join('');
}

$id('occasion-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  var editId = $id('occ-edit-id').value;
  var data = {
    name: $id('occ-input-name').value,
    slug: slugify($id('occ-input-slug').value),
    description: $id('occ-input-desc').value,
    icon: $id('occ-input-icon').value,
  };
  var url = editId ? '/api/occasions/' + editId : '/api/occasions';
  var method = editId ? 'PUT' : 'POST';

  var res = await fetch(url, {
    method: method,
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data),
  });

  if (res.ok) {
    closeOccasionModal();
    loadOccasions();
  } else {
    alert('Kaydetme başarısız!');
  }
});

window.editOccasion = function(id) {
  var o = _occasions.find(x => x.id === id);
  if (!o) return;
  $id('occ-edit-id').value = id;
  $id('occ-input-name').value = o.name;
  $id('occ-input-slug').value = o.slug;
  $id('occ-input-desc').value = o.description || '';
  $id('occ-input-icon').value = o.icon || '';
  
  $id('occasion-modal-title').textContent = 'Özel Gün Düzenle';
  $id('occasion-modal').classList.remove('hidden');
};

window.deleteOccasion = async function(id) {
  if (!confirm('Bu özel günü silmek istediğinize emin misiniz?')) return;
  var res = await fetch('/api/occasions/' + id, { method: 'DELETE' });
  if (res.ok) loadOccasions();
};

function openOccasionModal() {
  $id('occasion-form').reset();
  $id('occ-edit-id').value = '';
  $id('occasion-modal-title').textContent = 'Yeni Özel Gün';
  $id('occasion-modal').classList.remove('hidden');
}

function closeOccasionModal() {
  $id('occasion-modal').classList.add('hidden');
}

if ($id('add-occasion-btn')) $id('add-occasion-btn').addEventListener('click', openOccasionModal);
$id('occ-modal-cancel').addEventListener('click', closeOccasionModal);
$id('occasion-modal-backdrop').addEventListener('click', closeOccasionModal);

// Helper for "Add New" button in tab content headers
document.addEventListener('click', function(e) {
  if (e.target && e.target.id === 'add-category-btn') openCategoryModal();
  if (e.target && e.target.id === 'add-occasion-btn') openOccasionModal();
});

</script>

