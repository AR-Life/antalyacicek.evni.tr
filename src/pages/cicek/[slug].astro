---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProductBySlug, readProducts, type ProductImage } from "../../lib/products-store";
import { products as hardcodedProducts } from "../../data/products";
import { categories } from "../../data/categories";
import { SITE } from "../../data/site.config";
import { t } from "../../i18n/translations";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/config";
import { buildBreadcrumbSchema, buildFaqSchema, buildProductSchema, buildReviewSchema } from "../../lib/schema";

const locale = (Astro.locals.locale as Locale) || DEFAULT_LOCALE;

const { slug } = Astro.params;

let product: any = getProductBySlug(slug!);

if (!product) {
  product = hardcodedProducts.find((p: any) => p.slug === slug);
}

if (!product) {
  return Astro.redirect("/404");
}

const category = categories.find((c) => c.id === product.categoryId);
const mainImage = product.images?.[0]?.url || product.image || "https://placehold.co/800x1000/f5f5f5/fda4af?text=No+Image";
const hasDiscount = product.oldPrice && product.oldPrice > product.price;
const whatsappMessage = encodeURIComponent(`Merhaba, "${product.name}" siparişi vermek istiyorum.`);
const whatsappUrl = `https://wa.me/${SITE.phoneDigits}?text=${whatsappMessage}`;

const productTitle = `${product.name} - ${SITE.name}`;
const productDescription = `${product.description} | ${product.price.toLocaleString("tr-TR")} TL | ${SITE.name} - Aynı Gün Teslimat`;
const canonicalUrl = `${SITE.url}/cicek/${product.slug}`;

const galleryImages = product.images?.length ? product.images : (product.image ? [{ url: product.image, alt: product.name }] : [{ url: mainImage, alt: product.name }]);
const productSchema = buildProductSchema(product, {
  canonicalUrl,
  categoryName: category?.name || "Çiçek",
});
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Ana Sayfa", item: SITE.url },
  { name: "Çiçekler", item: `${SITE.url}/cicekler` },
  { name: product.name, item: canonicalUrl },
]);
const faqSchema = buildFaqSchema([
  {
    question: "Aynı gün teslimat mümkün mü?",
    answer: "Evet, Antalya içinde uygun saatlerde ve stok durumunda aynı gün teslimat yapılmaktadır. Siparişinizi erken saatlerde verdiğinizde teslim süresi kısalır.",
  },
  {
    question: "Çiçekler taze mi gelir?",
    answer: "Evet, tüm aranjmanlar taze kesim çiçeklerle hazırlanır ve teslimat öncesi kalite kontrolünden geçirilir.",
  },
  {
    question: "Özel günler için kişiye özel buket hazırlatabilir miyim?",
    answer: "Evet, özel mesaj, renk tercihleri ve ürün kombinasyonları için kurye ve müşteri temsilcisi ile iletişim kurulabilir.",
  },
]);
const reviewSchema = buildReviewSchema({
  reviewBody: "Hızlı teslimat, taze çiçekler ve özel tasarım yaklaşımı ile müşterilere güvenli ve keyifli bir sipariş deneyimi sunuluyor.",
  itemName: product.name,
  url: canonicalUrl,
});
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  image={mainImage}
  type="product"
  canonicalURL={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

  <section class="pt-28 pb-8 lg:pt-32 lg:pb-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-neutral-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-forest-700 transition-colors">{t(locale, "ui.home_page")}</a>
        <span>/</span>
        <a href="/cicekler" class="hover:text-forest-700 transition-colors">{t(locale, "ui.flowers_page")}</a>
        <span>/</span>
        <span class="text-neutral-600">{product.name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <div>
          <div class="relative aspect-[4/5] rounded-3xl overflow-hidden bg-neutral-50 shadow-lg mb-4">
            <img
              id="main-gallery-image"
              src={mainImage}
              alt={product.name}
              class="w-full h-full object-cover transition-opacity duration-300"
            />
            {hasDiscount && (
              <span class="absolute top-4 left-4 px-3 py-1.5 bg-forest-700 text-white text-sm font-bold rounded-full shadow-lg shadow-forest-700/30">
                %{Math.round(((product.oldPrice! - product.price) / product.oldPrice!) * 100)} İndirim
              </span>
            )}
          </div>

          {product.images && product.images.length > 1 && (
            <div class="flex gap-3 overflow-x-auto scrollbar-hide">
              {product.images.map((img: ProductImage, i: number) => (
                <button
                  type="button"
                  onclick={`document.getElementById('main-gallery-image')?.setAttribute('src','${img.url}')`}
                  class={`flex-none w-16 h-20 lg:w-20 lg:h-24 rounded-xl overflow-hidden border-2 transition-all ${i === 0 ? 'border-forest-700' : 'border-transparent hover:border-forest-300'}`}
                >
                  <img src={img.url} alt={img.alt || product.name} class="w-full h-full object-cover" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="flex flex-col">
          <div class="flex flex-wrap gap-2 mb-4">
            {product.tags?.map((tag: string) => (
              <span class="text-xs px-2.5 py-1 bg-forest-50 text-forest-800 font-medium rounded-full">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="text-2xl lg:text-3xl font-display font-bold text-neutral-900 leading-tight mb-4">
            {product.name}
          </h1>

          <p class="text-neutral-500 leading-relaxed mb-6">
            {product.description}
          </p>

          <div class="flex items-baseline gap-3 mb-6">
            <span class="text-3xl lg:text-4xl font-bold text-neutral-900">
              {product.price.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺
            </span>
            {hasDiscount && (
              <span class="text-lg text-neutral-400 line-through">
                {product.oldPrice!.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺
              </span>
            )}
          </div>

          <div class="space-y-3 mb-8">
            <div class="flex items-center gap-2 text-sm text-green-600">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-medium">{t(locale, "ui.same_day_delivery")}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-neutral-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{t(locale, "ui.delivery_2_hours")}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-neutral-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{t(locale, "ui.made_with_fresh_flowers")}</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3.5">
            <button
              type="button"
              data-order={JSON.stringify({ name: product.name, price: product.price, image: mainImage })}
              class="flex-1 flex items-center justify-center gap-2.5 px-6 py-4 bg-forest-800 hover:bg-forest-900 text-white text-sm sm:text-base font-bold rounded-2xl transition-all duration-200 shadow-lg shadow-forest-800/25 hover:shadow-xl hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              {t(locale, "ui.send_this_flower")}
            </button>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 px-6 py-4 bg-[#25D366] hover:bg-[#20bd5a] text-white text-sm sm:text-base font-bold rounded-2xl transition-all duration-200 shadow-lg shadow-[#25D366]/25 hover:shadow-xl hover:-translate-y-0.5"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-white animate-ping"></span>
              <span>🟢 {t(locale, "ui.whatsapp_direct", "WhatsApp Doğrudan Sipariş")}</span>
            </a>
          </div>

          <div class="mt-8 pt-8 border-t border-neutral-100 grid grid-cols-2 gap-4">
            <div class="text-center p-4 bg-forest-50 rounded-2xl">
              <span class="text-2xl">🚀</span>
              <p class="text-xs text-neutral-600 mt-1 font-medium">{t(locale, "ui.same_day")}</p>
              <p class="text-xs text-neutral-400">{t(locale, "ui.delivery")}</p>
            </div>
            <div class="text-center p-4 bg-green-50 rounded-2xl">
              <span class="text-2xl">💐</span>
              <p class="text-xs text-neutral-600 mt-1 font-medium">{t(locale, "ui.hundred_percent_fresh")}</p>
              <p class="text-xs text-neutral-400">{t(locale, "ui.flower_guarantee")}</p>
            </div>
            <div class="text-center p-4 bg-amber-50 rounded-2xl">
              <span class="text-2xl">📱</span>
              <p class="text-xs text-neutral-600 mt-1 font-medium">{t(locale, "ui.whatsapp")}</p>
              <p class="text-xs text-neutral-400">{t(locale, "ui.instant_order")}</p>
            </div>
            <div class="text-center p-4 bg-blue-50 rounded-2xl">
              <span class="text-2xl">🎁</span>
              <p class="text-xs text-neutral-600 mt-1 font-medium">{t(locale, "ui.special_package")}</p>
              <p class="text-xs text-neutral-400">{t(locale, "ui.gift_wrapping")}</p>
            </div>
          </div>
        </div>
      </div>

      {
        category && (
          <div class="mt-16">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h2 class="text-xl lg:text-2xl font-display font-bold text-neutral-900">{t(locale, "ui.similar_products")}</h2>
                <p class="text-sm text-neutral-500 mt-1">{category.name} {t(locale, "ui.other_products_from_category")}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
              {readProducts()
                .filter((p) => p.categoryId === category.id && p.id !== product.id)
                .slice(0, 4)
                .map((related) => {
                  const relImg = related.images?.[0]?.url || "https://placehold.co/400x500/f5f5f5/fda4af?text=No+Image";
                  return (
                    <a href={`/cicek/${related.slug}`} class="group block bg-white rounded-2xl shadow-sm hover:shadow-lg border border-neutral-100 hover:border-forest-200 transition-all duration-300 overflow-hidden">
                      <div class="aspect-[4/5] bg-neutral-50 overflow-hidden">
                        <img src={relImg} alt={related.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                      </div>
                      <div class="p-3">
                        <h3 class="text-sm font-semibold text-neutral-900 line-clamp-2 group-hover:text-forest-800 transition-colors">{related.name}</h3>
                        <span class="text-sm font-bold text-neutral-900 mt-1 block">{related.price.toLocaleString("tr-TR", { minimumFractionDigits: 2 })} ₺</span>
                      </div>
                    </a>
                  );
                })}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <script>
    document.querySelectorAll('[onclick]').forEach((el) => {
      const attr = el.getAttribute('onclick');
      if (attr?.includes('setAttribute')) {
        el.addEventListener('click', () => {
          document.querySelectorAll('.border-forest-700').forEach(b => {
            b.classList.remove('border-forest-700');
            b.classList.add('border-transparent');
          });
          el.classList.add('border-forest-700');
          el.classList.remove('border-transparent');
        });
      }
    });
  </script>

  <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-neutral-200 p-4 lg:hidden">
    <div class="flex items-center gap-3">
      <div class="flex-1 min-w-0">
        <p class="text-xs text-neutral-500 truncate">{product.name}</p>
        <p class="text-lg font-bold text-forest-800">{product.price.toLocaleString("tr-TR", { minimumFractionDigits: 2 })} ₺</p>
      </div>
      <button
        data-order={JSON.stringify({
          name: product.name,
          price: product.price,
          image: mainImage,
        })}
        class="px-6 py-3 bg-forest-700 hover:bg-forest-800 text-white font-bold rounded-xl transition-all shadow-md"
      >
        Sipariş Ver
      </button>
    </div>
  </div>
</BaseLayout>
