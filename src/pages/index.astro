---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import ProductCard from "../components/ProductCard.astro";
import Steps from "../components/Steps.astro";
import { categories } from "../data/categories";
import { occasions } from "../data/occasions";
import { products, getBestSellers, getProductsByCategory, getAllProducts } from "../data/products";
import { contactInfo } from "../data/contact-info";

const allProducts = getAllProducts();
const featuredProducts = allProducts.slice(0, 8);
const nonEmptyCategories = categories.filter((c) => getProductsByCategory(c.id).length > 0);


---

<BaseLayout>
  <HeroSection />

  <section id="kategoriler" class="py-8 lg:py-12 bg-gradient-to-b from-white to-forest-50/30 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-6 lg:mb-8">
        <h2 class="text-2xl lg:text-3xl font-display font-bold text-neutral-900 mb-2">
          Kategoriler
        </h2>
        <p class="text-neutral-500 max-w-xl mx-auto text-xs lg:text-sm">
          Her anı özel kılan el yapımı çiçek aranjmanları
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <!-- Row 1: Çiçek Türleri -->
        <div>
          <h3 class="text-xs lg:text-sm font-bold text-forest-700 uppercase tracking-widest mb-3 px-1">🌸 Çiçek Türleri</h3>
          <div class="marquee-wrapper" data-marquee="categories">
            <div class="marquee-track">
              {[...Array(4)].map(() => (
                <div class="marquee-content">
                  {nonEmptyCategories.map((category) => {
                    const catProducts = getProductsByCategory(category.id);
                    const thumbImage = catProducts.length > 0
                      ? (catProducts[0].image || "/images/placeholder.svg")
                      : "/images/placeholder.svg";
                    return (
                      <a
                        href={`#cat-${category.slug}`}
                        class="flex-none flex flex-col items-center gap-2 group/item marquee-item"
                      >
                        <div class="w-[72px] h-[72px] lg:w-[88px] lg:h-[88px] rounded-full border-[3px] border-forest-500 p-[2.5px] transition-all duration-300 group-hover/item:border-forest-600 group-hover/item:shadow-lg group-hover/item:shadow-forest-500/20 group-hover/item:scale-110">
                          <div class="w-full h-full rounded-full overflow-hidden bg-neutral-100">
                            <img
                              src={thumbImage}
                              alt={category.name}
                              loading="lazy"
                              width="88"
                              height="88"
                              class="w-full h-full object-cover"
                            />
                          </div>
                        </div>
                        <span class="text-[11px] lg:text-xs font-semibold text-neutral-700 text-center leading-tight max-w-[76px] lg:max-w-[90px] group-hover/item:text-forest-700 transition-colors duration-200">
                          {category.name}
                        </span>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Row 2: Gönderim Amacı -->
        <div>
          <h3 class="text-xs lg:text-sm font-bold text-amber-600 uppercase tracking-widest mb-3 px-1">🎁 Gönderim Amacı</h3>
          <div class="marquee-wrapper" data-marquee="occasions">
            <div class="marquee-track marquee-reverse">
              {[...Array(4)].map(() => (
                <div class="marquee-content">
                  {occasions.map((occasion) => (
                    <a
                      href={`/firsatlar/${occasion.slug}`}
                      class="flex-none flex flex-col items-center gap-2 group/item marquee-item"
                    >
                      <div class="w-[72px] h-[72px] lg:w-[88px] lg:h-[88px] rounded-full border-[3px] border-amber-400 p-[2.5px] transition-all duration-300 group-hover/item:border-amber-500 group-hover/item:shadow-lg group-hover/item:shadow-amber-400/20 group-hover/item:scale-110">
                        <div class="w-full h-full rounded-full overflow-hidden bg-amber-50 flex items-center justify-center">
                          <span class="text-2xl lg:text-3xl">{occasion.icon}</span>
                        </div>
                      </div>
                      <span class="text-[11px] lg:text-xs font-semibold text-neutral-700 text-center leading-tight max-w-[76px] lg:max-w-[90px] group-hover/item:text-amber-700 transition-colors duration-200">
                        {occasion.name}
                      </span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .marquee-wrapper {
      position: relative;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
      mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    }
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee-scroll 30s linear infinite;
    }
    .marquee-track.marquee-reverse {
      animation: marquee-scroll-reverse 35s linear infinite;
    }
    .marquee-content {
      display: flex;
      gap: 1.25rem;
      padding-right: 1.25rem;
    }
    @media (min-width: 1024px) {
      .marquee-content {
        gap: 1.75rem;
        padding-right: 1.75rem;
      }
    }

    /* Pause on hover (desktop) */
    .marquee-wrapper:hover .marquee-track {
      animation-play-state: paused;
    }
    /* Pause on touch (mobile) - managed via JS class */
    .marquee-wrapper.is-touching .marquee-track {
      animation-play-state: paused;
    }

    @keyframes marquee-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes marquee-scroll-reverse {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0); }
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .marquee-track {
        animation: none !important;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .marquee-track::-webkit-scrollbar {
        display: none;
      }
      .marquee-wrapper {
        -webkit-mask-image: none;
        mask-image: none;
      }
    }
  </style>

  <script is:inline>
  (function() {
    var wrappers = document.querySelectorAll('.marquee-wrapper');
    wrappers.forEach(function(wrapper) {
      wrapper.addEventListener('touchstart', function() {
        wrapper.classList.add('is-touching');
      }, { passive: true });
      wrapper.addEventListener('touchend', function() {
        wrapper.classList.remove('is-touching');
      }, { passive: true });
    });
  })();
  </script>

  <CategoryTabs categories={categories} />

  <section id="one-cikanlar" class="py-16 lg:py-24 bg-gradient-to-b from-forest-50/30 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 lg:mb-14">
        <span class="inline-block text-xs uppercase tracking-widest text-forest-600 font-bold mb-2">
          En Çok Tercih Edilenler
        </span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-3">
          Öne Çıkan Ürünler
        </h2>
        <p class="text-neutral-500 max-w-xl mx-auto text-sm lg:text-base">
          Müşterilerimizin en çok beğendiği çiçek aranjmanları
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="text-center mt-10 lg:mt-14">
        <a
          href="/cicekler"
          class="inline-flex items-center gap-2 px-8 py-4 bg-forest-700 hover:bg-forest-800 text-white font-semibold rounded-full transition-all duration-300 shadow-lg shadow-forest-700/20 hover:shadow-xl hover:shadow-forest-700/30 hover:-translate-y-0.5"
        >
          Tüm Ürünleri Gör
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Steps />

  <section class="py-16 lg:py-24 bg-gradient-to-br from-forest-50 via-white to-rose-50/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
        Siparişinizi Hemen Verin
      </h2>
      <p class="text-neutral-500 max-w-xl mx-auto mb-8 text-sm lg:text-base">
        WhatsApp üzerinden siparişinizi iletin, çiçekleriniz aynı gün kapınızda olsun.
      </p>
      <a
        href={`https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-8 py-4 bg-green-500 hover:bg-green-600 text-white text-base font-semibold rounded-full transition-all duration-300 shadow-xl shadow-green-500/25 hover:shadow-2xl hover:shadow-green-500/30 hover:-translate-y-1"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        WhatsApp ile Sipariş Ver
      </a>
    </div>
  </section>
</BaseLayout>
