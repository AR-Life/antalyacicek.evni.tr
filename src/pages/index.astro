---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import CategorySlider from "../components/CategorySlider.astro";
import ProductCard from "../components/ProductCard.astro";
import Steps from "../components/Steps.astro";
import { categories } from "../data/categories";
import { products, getBestSellers, getProductsByCategory, getAllProducts } from "../data/products";

const allProducts = getAllProducts();
const bestSellers = getBestSellers();
const nonEmptyCategories = categories.filter((c) => getProductsByCategory(c.id).length > 0);
---

<BaseLayout>
  <HeroSection />

  <section id="kategoriler" class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-16">
        <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
          Kategoriler
        </h2>
        <p class="text-neutral-500 max-w-xl mx-auto text-sm lg:text-base">
          Her anı özel kılan el yapımı çiçek aranjmanları ve buket seçenekleri.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
        {nonEmptyCategories.map((category) => (
          <a
            href={`#cat-${category.slug}`}
            class="group relative aspect-[4/5] rounded-2xl overflow-hidden bg-neutral-50 shadow-sm hover:shadow-lg transition-all duration-300"
          >
            <img
              src={category.image}
              alt={category.name}
              loading="lazy"
              width="300"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="text-white font-semibold text-sm lg:text-base">
                {category.name}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {nonEmptyCategories.map((category) => (
    <div id={`cat-${category.slug}`} class="bg-neutral-50/50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <CategorySlider category={category} />
      </div>
    </div>
  ))}

  <section id="urunler" class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-16">
        <span class="text-rose-500 text-sm font-semibold uppercase tracking-wider">
          Hızlı Teslimat
        </span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mt-2 mb-4">
          Tüm Ürünler
        </h2>
        <p class="text-neutral-500 max-w-xl mx-auto text-sm lg:text-base">
          En taze çiçeklerden el yapımı aranjmanlar. Her biri özenle hazırlanır, aynı gün teslim edilir.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        {allProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <Steps />

  <section class="py-16 lg:py-20 bg-gradient-to-br from-rose-50 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
        Siparişinizi Hemen Verin
      </h2>
      <p class="text-neutral-500 max-w-xl mx-auto mb-8 text-sm lg:text-base">
        WhatsApp üzerinden siparişinizi iletin, çiçekleriniz aynı gün kapınızda olsun.
      </p>
      <a
        href="https://wa.me/905001234567?text=Merhaba, sipariş vermek istiyorum."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-8 py-4 bg-green-500 hover:bg-green-600 text-white text-base font-semibold rounded-full transition-all duration-300 shadow-xl shadow-green-500/25 hover:shadow-2xl hover:shadow-green-500/30"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        WhatsApp ile Sipariş Ver
      </a>
    </div>
  </section>
</BaseLayout>
