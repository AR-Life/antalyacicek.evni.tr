---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactInfo, generateContactPageSchema, generateLocalBusinessSchema } from "../data/contact-info";
import { SITE } from "../data/site.config";

const pageTitle = `İletişim - ${contactInfo.businessName} | ${SITE.name}`;
const pageDescription = `${contactInfo.businessName} iletişim bilgileri. Telefon: ${contactInfo.phoneDisplay}, Adres: ${contactInfo.address.fullAddress}`;
const canonicalUrl = `${SITE.url}/iletisim`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(generateContactPageSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(generateLocalBusinessSchema())} />

  <div class="pt-28 pb-16 lg:pt-32">
    <section class="bg-gradient-to-br from-forest-50 via-white to-rose-50/30 py-12 lg:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl lg:text-4xl font-display font-bold text-neutral-900 mb-4">
          İletişim
        </h1>
        <p class="text-neutral-500 max-w-2xl mx-auto text-base lg:text-lg">
          Bize ulaşmak için aşağıdaki bilgileri kullanabilirsiniz.
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-16 bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
          
          <div class="space-y-6">
            <div class="bg-forest-50 rounded-2xl p-6 lg:p-8">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-forest-700 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-neutral-900 mb-1">Telefon</h3>
                  <a href={`tel:${contactInfo.phone}`} class="text-forest-700 hover:text-forest-800 font-semibold text-lg">
                    {contactInfo.phoneDisplay}
                  </a>
                  <p class="text-sm text-neutral-500 mt-1">7/24 arayabilirsiniz</p>
                </div>
              </div>
            </div>

            <div class="bg-green-50 rounded-2xl p-6 lg:p-8">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-neutral-900 mb-1">WhatsApp</h3>
                  <a href={`https://wa.me/${contactInfo.whatsapp}?text=${encodeURIComponent(contactInfo.whatsappMessage)}`} target="_blank" rel="noopener noreferrer" class="text-green-600 hover:text-green-700 font-semibold text-lg">
                    Hızlı Sipariş Ver
                  </a>
                  <p class="text-sm text-neutral-500 mt-1">Anında yanıt alın</p>
                </div>
              </div>
            </div>

            <div class="bg-neutral-50 rounded-2xl p-6 lg:p-8">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-neutral-700 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-neutral-900 mb-1">Adres</h3>
                  <p class="text-neutral-700 font-medium">{contactInfo.address.fullAddress}</p>
                  <a href={`https://maps.google.com/?q=${encodeURIComponent(contactInfo.address.fullAddress)}`} target="_blank" rel="noopener noreferrer" class="text-forest-700 hover:text-forest-800 text-sm font-semibold mt-2 inline-block">
                    Haritada Gör →
                  </a>
                </div>
              </div>
            </div>

            <div class="bg-rose-50 rounded-2xl p-6 lg:p-8">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-rose-500 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-neutral-900 mb-1">E-posta</h3>
                  <a href={`mailto:${contactInfo.email}`} class="text-rose-600 hover:text-rose-700 font-semibold">
                    {contactInfo.email}
                  </a>
                  <p class="text-sm text-neutral-500 mt-1">24 saat içinde yanıt</p>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="bg-white rounded-2xl p-6 lg:p-8 border border-forest-100 shadow-sm">
              <h3 class="text-xl font-display font-bold text-neutral-900 mb-4">Çalışma Saatleri</h3>
              <div class="space-y-3">
                {contactInfo.openingHours.map((oh) => (
                  <div class="flex items-center justify-between py-2 border-b border-neutral-100 last:border-0">
                    <span class="text-neutral-700 font-medium">{oh.day}</span>
                    <span class="text-forest-700 font-semibold">{oh.hours}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="bg-white rounded-2xl p-6 lg:p-8 border border-forest-100 shadow-sm">
              <h3 class="text-xl font-display font-bold text-neutral-900 mb-4">Teslimat Bölgeleri</h3>
              <div class="flex flex-wrap gap-2">
                {contactInfo.delivery.areas.map((area) => (
                  <span class="px-3 py-1.5 bg-forest-50 text-forest-800 text-sm font-medium rounded-full">
                    {area}
                  </span>
                ))}
              </div>
              <p class="text-sm text-neutral-500 mt-4">
                <span class="font-semibold text-forest-700">{contactInfo.delivery.freeDeliveryMin} TL</span> üzeri siparişlerde ücretsiz teslimat
              </p>
            </div>

            <div class="bg-white rounded-2xl p-6 lg:p-8 border border-forest-100 shadow-sm">
              <h3 class="text-xl font-display font-bold text-neutral-900 mb-4">Ödeme Yöntemleri</h3>
              <div class="flex flex-wrap gap-2">
                {contactInfo.payment.methods.map((method) => (
                  <span class="px-3 py-1.5 bg-neutral-100 text-neutral-700 text-sm font-medium rounded-full">
                    {method}
                  </span>
                ))}
              </div>
            </div>

            <div class="bg-white rounded-2xl p-6 lg:p-8 border border-forest-100 shadow-sm">
              <h3 class="text-xl font-display font-bold text-neutral-900 mb-4">Bizi Takip Edin</h3>
              <div class="flex gap-3">
                <a href={contactInfo.social.instagram} target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center text-white hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
                <a href={contactInfo.social.facebook} target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center text-white hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
