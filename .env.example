# Cloudflare R2 Storage
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=antalyacicek
R2_PUBLIC_URL=https://images.antalyacicek.evni.tr

# Admin giriş bilgileri
ADMIN_EMAIL=admin@antalyacicek.evni.tr
ADMIN_PASSWORD=changeme123

# JWT Secret (en az 32 karakter, güvenli rastgele bir değer)
# Cloudflare Dashboard > Workers & Pages > antalyacicek-evni-tr > Settings > Variables > Secrets
# openssl rand -base64 32
JWT_SECRET=